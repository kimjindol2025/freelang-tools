{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freelang.dev/schemas/backend-contract.schema.json",
  "title": "FreeLang backend contract",
  "type": "object",
  "required": ["schemaVersion", "source", "status", "categories", "passCount", "blockedCount", "next"],
  "properties": {
    "schemaVersion": {"const": "freelang.backend-contract/v1"},
    "source": {"const": "freelang-native"},
    "status": {"enum": ["PASS", "BLOCKED"]},
    "categories": {"type": "array", "items": {"$ref": "#/$defs/category"}},
    "passCount": {"type": "integer", "minimum": 0},
    "blockedCount": {"type": "integer", "minimum": 0},
    "next": {"type": "string"}
  },
  "$defs": {
    "category": {
      "type": "object",
      "required": ["name", "result", "api", "boundary"],
      "properties": {
        "name": {"type": "string"},
        "api": {"type": "string"},
        "boundary": {"type": "string"},
        "result": {
          "type": "object",
          "required": ["ok", "status", "error"],
          "properties": {
            "ok": {"type": "boolean"},
            "status": {"type": "string"},
            "error": {"type": ["string", "null"]}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
