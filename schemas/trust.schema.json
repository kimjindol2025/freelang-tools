{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freelang.tools/schemas/trust.schema.json",
  "title": "FreeLang Tools Trust Report",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "verdict", "project", "gates", "decision", "limitations", "evidence", "next"],
  "properties": {
    "schemaVersion": { "const": "freelang.trust/v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "verdict": { "enum": ["TRUSTED", "TRUSTED_WITH_APPROVAL", "UNTRUSTED", "BLOCKED"] },
    "project": {
      "type": "object",
      "required": ["name", "root", "dialect", "runner"],
      "properties": {
        "name": { "type": "string" },
        "root": { "type": "string" },
        "dialect": { "type": "string" },
        "runner": { "type": "string" }
      },
      "additionalProperties": false
    },
    "git": { "type": "object" },
    "gates": {
      "type": "object",
      "required": ["check", "test", "review", "evidence", "diffCheck", "workflow", "capabilityCoverage"],
      "properties": {
        "check": { "type": "string" },
        "test": { "type": "string" },
        "review": { "type": "string" },
        "evidence": { "type": "string" },
        "diffCheck": { "type": "string" },
        "workflow": { "type": "string" },
        "capabilityCoverage": { "enum": ["FULL", "PARTIAL", "UNKNOWN"] }
      },
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "required": ["source", "command"],
      "properties": {
        "source": { "type": "string" },
        "command": { "const": "trust-core" }
      },
      "additionalProperties": false
    },
    "approvalRequired": { "type": "boolean" },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "evidence": {
      "type": "object",
      "required": ["commands", "artifacts"],
      "properties": {
        "commands": { "type": "array", "items": { "type": "string" } },
        "artifacts": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "next": { "type": "string" }
  },
  "additionalProperties": false
}
