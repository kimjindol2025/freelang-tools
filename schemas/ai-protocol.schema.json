{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freelang.tools/schemas/ai-protocol.schema.json",
  "title": "FreeLang AI Protocol",
  "type": "object",
  "required": ["protocol", "action", "status", "project", "verdict", "decision", "canProceed", "execution", "next"],
  "properties": {
    "protocol": { "const": "freelang.ai/v1" },
    "action": { "enum": ["ready", "start", "work", "verify", "release"] },
    "status": { "enum": ["READY", "NOT_READY", "BLOCKED"] },
    "project": { "type": "object" },
    "verdict": { "enum": ["TRUSTED", "TRUSTED_WITH_APPROVAL", "UNTRUSTED", "BLOCKED"] },
    "decision": {
      "type": "object",
      "required": ["source", "command"],
      "properties": { "source": { "type": "string" }, "command": { "enum": ["trust-core", "preflight"] } },
      "additionalProperties": false
    },
    "canProceed": { "type": "boolean" },
    "approvalRequired": { "type": "boolean" },
    "execution": { "const": "not-run" },
    "next": { "type": "string" },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "evidence": { "type": "object" },
    "trustExitCode": { "type": "integer" },
    "summary": { "type": "object" },
    "trust": { "type": "object" }
  },
  "additionalProperties": false
}
