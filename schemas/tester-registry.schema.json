{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freelang.tools/schemas/tester-registry.schema.json",
  "title": "FreeLang Tools Tester Registry Result",
  "type": "object",
  "required": ["schemaVersion", "source", "verdict", "expectedCount", "resultCount", "missing", "registry"],
  "properties": {
    "schemaVersion": { "const": "freelang.tester-registry/v1" },
    "source": { "const": "freelang-native" },
    "verdict": { "enum": ["PASS", "FAIL", "BLOCKED", "UNRESOLVED"] },
    "expectedCount": { "type": "integer", "minimum": 1 },
    "resultCount": { "type": "integer", "minimum": 0 },
    "missing": { "type": "array", "items": { "type": "string" } },
    "invalidCount": { "type": "integer", "minimum": 0 },
    "unknownCount": { "type": "integer", "minimum": 0 },
    "failedCount": { "type": "integer", "minimum": 0 },
    "blockedCount": { "type": "integer", "minimum": 0 },
    "notRunCount": { "type": "integer", "minimum": 0 },
    "registry": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "owner"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string" },
          "owner": { "const": "freelang-native" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
