;; FreeLang-native trust decision core.
;; 호스트는 실제 관문 결과만 수집하고, 최종 AI 사용 판정은 FreeLang이 소유한다.

(load "trust-decision-contract.fl")

(defn value-or [value fallback]
  {:context "Use a stable fallback for missing trust gate fields"
   :returns "value or fallback"
   :effects []}
  (if (or (nil? value) (= value "")) fallback value))

(defn pass? [value]
  {:context "Recognize a successful gate without coercing blocked states"
   :returns "boolean"
   :effects []}
  (or (= value "PASS") (= value "PASS_WITH_APPROVAL")))

(let [input-path (shell_env "FL_TOOLS_TRUST_INPUT")
      input (if (and (string? input-path) (file-exists input-path))
              (json-parse (file-read input-path))
              {})
      project (value-or (get input "project") "unknown")
      check (value-or (get input "check") "BLOCKED")
      test (value-or (get input "test") "BLOCKED")
      review (value-or (get input "review") "BLOCKED")
      evidence (value-or (get input "evidence") "BLOCKED")
      diff-check (value-or (get input "diffCheck") "BLOCKED")
      workflow (value-or (get input "workflow") "NOT_APPLICABLE")
      self-host (value-or (get input "selfHost") "BLOCKED")
      mode (value-or (get input "mode") "deep")
      approval-required (= (get input "approvalRequired") true)
      decision (trust-decision mode check test review evidence diff-check workflow self-host approval-required)
      core-ready (get decision "coreReady")
      verdict (get decision "verdict")]
  (println (json-stringify
             {"schemaVersion" "freelang.trust/v1"
              "source" "freelang-native"
              "command" "trust-core"
              "project" project
              "mode" mode
              "verdict" verdict
              "coreReady" core-ready
              "approvalRequired" approval-required
              "next" (case verdict
                       "TRUSTED" "safe-to-use"
                       "TRUSTED_WITH_APPROVAL" "obtain-user-approval-before-deploy"
                       "fix-blocked-gates-and-rerun-trust")})))
