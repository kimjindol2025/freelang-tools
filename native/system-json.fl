;; FreeLang-native system/file/JSON standard API runner.
(load "system-json-core.fl")

(let [action (shell_env "FL_TOOLS_SYSTEM_JSON_ACTION")
      root (shell_env "FL_TOOLS_SYSTEM_JSON_ROOT")
      path (shell_env "FL_TOOLS_SYSTEM_JSON_PATH")
      payload (shell_env "FL_TOOLS_SYSTEM_JSON_PAYLOAD")]
  (println (json-stringify (run-action action root path payload))))
