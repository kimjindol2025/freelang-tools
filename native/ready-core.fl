;; FreeLang-native readiness decision and report.
;; The only host boundary is argv-safe Git/file observation.

(let [projectName (shell_env "FL_TOOLS_READY_PROJECT")
      rootPath (shell_env "FL_TOOLS_READY_ROOT")
      dialectValue (shell_env "FL_TOOLS_READY_DIALECT")
      familyValue (shell_env "FL_TOOLS_READY_FAMILY")
      runnerValue (shell_env "FL_TOOLS_READY_RUNNER")
      gitValue {"state" (shell_env "FL_TOOLS_READY_GIT_STATE")
                "branch" (shell_env "FL_TOOLS_READY_GIT_BRANCH")
                "commit" (shell_env "FL_TOOLS_READY_GIT_COMMIT")}
      runnerReady (if (= dialectValue "NODE")
                    (and (file-exists (str rootPath "/package.json"))
                         (file-exists (str rootPath "/node_modules")))
                    (and (not= runnerValue "none") (file-exists runnerValue)))
      statusValue (if (or (= dialectValue "UNKNOWN") (= dialectValue "")) "BLOCKED"
                    (if (= (get gitValue "state") "not-a-repository") "BLOCKED"
                      (if (not runnerReady) "BLOCKED"
                        (if (= (get gitValue "state") "dirty") "READY_WITH_CHANGES" "READY"))))
      reasonValue (if (= statusValue "BLOCKED")
                    (if (or (= dialectValue "UNKNOWN") (= dialectValue "")) "unknown-project-dialect"
                      (if (= (get gitValue "state") "not-a-repository") "not-a-git-project" "runner-or-dependencies-not-ready"))
                    (if (= statusValue "READY_WITH_CHANGES") "dirty-worktree-review-before-deploy" "ready-for-ai"))
      result {"schemaVersion" "freelang.ready/v1"
              "status" statusValue
              "project" {"name" projectName "root" rootPath "dialect" dialectValue "family" familyValue "runner" runnerValue}
              "git" gitValue
              "dependencies" {"runnerReady" runnerReady}
              "next" (if (= statusValue "BLOCKED") "resolve-readiness-reason-and-rerun" (str "fl-tools ai verify " rootPath))
              "reason" reasonValue}]
  (println (json-stringify result))
  (if (= statusValue "BLOCKED") (throw "readiness-blocked") nil))
