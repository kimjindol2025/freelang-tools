;; FreeLang-native project detection.
;; Recursive filesystem inspection is owned by the AFJ filesystem API.

(defn has-file? [root name]
  {:context "Check one project file without shell interpolation"
   :returns "boolean"
   :effects ["file-read"]}
  (file-exists (str root "/" name)))

(defn has-suffix? [files suffix]
  {:context "Check whether a discovered file has one source suffix"
   :returns "boolean"
   :effects []}
  (> (length (filter (fn [path] (str-ends-with path suffix)) files)) 0))

(defn has-path? [files name]
  {:context "Check a discovered relative or absolute file name"
   :returns "boolean"
   :effects []}
  (> (length (filter (fn [path] (str-ends-with path (str "/" name))) files)) 0))

(defn direct-test-files [root]
  {:context "Discover direct FreeLang test files for project context reporting"
   :returns "sorted absolute test paths"
   :effects ["directory-read" "file-read"]}
  (let [test-root (str root "/tests")]
    (if (file-exists test-root)
      (map (fn [name] (str test-root "/" name))
           (sort (filter (fn [name] (str-ends-with name ".test.fl"))
                         (dir-list test-root))))
      [])))

(defn walk-files [root depth]
  {:context "Recursively list files under an explicit project root"
   :returns "absolute file paths"
   :effects ["directory-read" "file-read"]}
  (if (> depth 3)
    []
    (if (dir-exists? root)
      (mapcat
        (fn [name]
          (let [path (str root "/" name)]
            (if (file-exists path)
              [path]
              (if (dir-exists? path)
                (walk-files path (+ depth 1))
                []))))
        (dir-list root))
      [])))

(defn first-existing [candidates]
  {:context "Select the first available FreeLang runner candidate"
   :returns "path or none"
   :effects ["file-read"]}
  (if (= (length candidates) 0)
    "none"
    (if (file-exists (get candidates 0))
      (get candidates 0)
      (first-existing (slice candidates 1 (length candidates))))))

(defn family-for [dialect root]
  {:context "Map detected dialect to the stable project family"
   :returns "family string"
   :effects ["file-read"]}
  (if (= dialect "AIRC") "AIRC"
    (if (= dialect "TOOLS") "FREELANG_TOOLS"
    (if (= dialect "AIA") "AIA"
      (if (= dialect "FRONT") (if (or (has-file? root "server.fl") (has-file? root "web/server.fl")) "FRONT/AFJ" "FRONT")
        (if (= dialect "SCRIPT") "SCRIPT"
          (if (= dialect "AFJ") "AFJ"
            (if (= dialect "FX") "FX"
              (if (= dialect "NODE") "NODE" "UNKNOWN")))))))))

(defn runner-for [dialect root]
  {:context "Select the canonical runner for the detected dialect"
   :returns "runner path or none"
   :effects ["file-read"]}
  (if (= dialect "AIRC") (first-existing [
                                       (str root "/bootstrap.js")
                                       "/home/kim/kim/platform/freelang-v11-fx/bootstrap.js"
                                       "/home/kim/kim/platform/freelang-v11/bootstrap.js"
                                       "/home/kim/freelang-v11/bootstrap.js"])
    (if (= dialect "TOOLS") (str root "/scripts/fl-tools")
    (if (= dialect "AIA") (if (has-file? root "tools/verify-aia-cold-boot.sh") (str root "/tools/verify-aia-cold-boot.sh") "none")
      (if (= dialect "FRONT") (if (has-file? root "fl-front-build.js") (str root "/fl-front-build.js")
                                  (if (has-file? root "web/fl-front-build.js") (str root "/web/fl-front-build.js") "none")
        (if (= dialect "SCRIPT") (if (has-file? root "bin/fl-script-unified.js") (str root "/bin/fl-script-unified.js") "none")
          (if (= dialect "AFJ") "none"
            (if (= dialect "FX") (if (has-file? root "fl-test.sh") (str root "/fl-test.sh") "none")
              (if (= dialect "NODE") (str root "/package.json") "none"))))))))))

(defn detect [root]
  {:context "Detect project dialect, runner, tests, and source extensions"
   :returns "FreeLang project detection report"
   :effects ["file-read" "directory-read"]}
  (let [files (sort (walk-files root 0))
        ;; The native runner can execute the canonical tool entrypoint even
        ;; when the host process adapter returns no recursive listing.
        native-tools? (has-file? root "native/tools-cli.fl")
        fl? (or native-tools? (has-suffix? files ".fl"))
        fls? (has-suffix? files ".fls")
        flx? (has-suffix? files ".flx")
        aia? (has-suffix? files ".aia")
        airc? (has-suffix? files ".airc")
        detectedDialect (if (and native-tools? (has-file? root "scripts/fl-tools")) "TOOLS"
                  (if (or (has-file? root "airc.fl")
                        (and (has-file? root "SPEC.airc") airc?)) "AIRC"
                  (if (or (has-file? root "tools/verify-aia-cold-boot.sh") aia?) "AIA"
                    (if (or (has-file? root "fl-front-build.js") (has-file? root "web/fl-front-build.js") flx?) "FRONT"
                      (if (or (has-file? root "freelang.json") (has-file? root "bin/fl-script-unified.js") fls?) "SCRIPT"
                        (if (or fl? (has-suffix? files ".fl")) "AFJ" (if (has-file? root "package.json") "NODE"
                                          (if (or (has-file? root "fl-test.sh") (has-file? root "fl-run.sh") (has-file? root "fx-std.fl")) "FX" "UNKNOWN"))))))))
        familyValue (if (= detectedDialect "AIRC") "AIRC"
                     (if (= detectedDialect "TOOLS") "FREELANG_TOOLS"
                     (if (= detectedDialect "AIA") "AIA"
                       (if (= detectedDialect "FRONT") "FRONT"
                         (if (= detectedDialect "SCRIPT") "SCRIPT"
                           (if (= detectedDialect "AFJ") "AFJ"
                             (if (= detectedDialect "FX") "FX"
                               (if (= detectedDialect "NODE") "NODE" "UNKNOWN"))))))))
        runnerValue (if (= detectedDialect "AIRC") (first-existing [
                                                   (str root "/bootstrap.js")
                                                   "/home/kim/kim/platform/freelang-v11-fx/bootstrap.js"
                                                   "/home/kim/kim/platform/freelang-v11/bootstrap.js"
                                                   "/home/kim/freelang-v11/bootstrap.js"])
                         (if (= detectedDialect "TOOLS") (str root "/scripts/fl-tools")
                         (if (= detectedDialect "AFJ") "none"
                         (if (= detectedDialect "AIA") (if (has-file? root "tools/verify-aia-cold-boot.sh") (str root "/tools/verify-aia-cold-boot.sh") "none")
                           (if (= detectedDialect "FRONT") (if (has-file? root "fl-front-build.js") (str root "/fl-front-build.js")
                                                       (if (has-file? root "web/fl-front-build.js") (str root "/web/fl-front-build.js") "none")
                             (if (= detectedDialect "SCRIPT") (if (has-file? root "bin/fl-script-unified.js") (str root "/bin/fl-script-unified.js") "none")
                               (if (= detectedDialect "FX") (if (has-file? root "fl-test.sh") (str root "/fl-test.sh") "none")
                                 (if (= detectedDialect "NODE") (str root "/package.json") "none")))))))))
        discoveredTests (direct-test-files root)]
    {"project" (first (reverse (str-split root "/")))
     "root" root
     "dialect" detectedDialect
     "family" familyValue
     "extensions" (filter (fn [ext] (contains? [".fl" ".fls" ".flx" ".aia" ".airc"] ext))
                          (concat (if fl? [".fl"] [])
                                  (concat (if fls? [".fls"] [])
                                          (concat (if flx? [".flx"] [])
                                                  (concat (if aia? [".aia"] []) (if airc? [".airc"] []))))))
     "runner" runnerValue
     "testRoot" (str root "/tests")
     "testFiles" (if (> (length discoveredTests) 0) (str-join "," discoveredTests) "none")}))

(let [root (shell_env "FL_TOOLS_DETECT_ROOT")
      value (detect root)]
  (println (str "PROJECT=" (get value "project")))
  (println (str "ROOT=" (get value "root")))
  (println (str "DIALECT=" (get value "dialect")))
  (println (str "FAMILY=" (get value "family")))
  (println (str "EXTENSIONS=" (str-join " " (get value "extensions"))))
  (println (str "RUNNER=" (get value "runner")))
  (if (= (get value "runner") "none")
    (println "CAUSE=AFJ-error-output-differs-from-bootstrap"))
  (println (str "TEST_ROOT=" (get value "testRoot")))
  (println (str "TEST_FILES=" (get value "testFiles"))))
