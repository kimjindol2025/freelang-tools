;; FreeLang-native test output classifier.
;; The host executes the runner; this module owns pass/fail interpretation.

(load "test-result-contract.fl")

(let [path (shell_env "FL_TOOLS_TEST_OUTPUT")
      output (if (file-exists path) (file-read path) "")
      passed (test-output-pass? output)]
  (if passed
    (println "TEST_RESULT=PASS")
    (do
      (println "TEST_RESULT=FAIL")
      (throw "test-result-failed"))))
