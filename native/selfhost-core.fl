;; FreeLang-native AFJ runner smoke.

(let [check-path (shell_env "FL_TOOLS_SELFHOST_CHECK_OUTPUT")
      run-path (shell_env "FL_TOOLS_SELFHOST_RUN_OUTPUT")
      check-code (shell_env "FL_TOOLS_SELFHOST_CHECK_CODE")
      run-code (shell_env "FL_TOOLS_SELFHOST_RUN_CODE")
      check (if (file-exists check-path) (file-read check-path) "")
      run (if (file-exists run-path) (file-read run-path) "")
      check-ok (and (str-contains-in check "Compiled ")
                    (not (str-contains-in check "[CGC-ERR]")))
      run-ok (str-contains-in run "SELFHOST_PROBE=PASS")
      check-pass (and (= check-code "0") check-ok)
      run-pass (and (= run-code "0") run-ok)
      ok (and check-pass run-pass)]
  (println (str "SELFHOST_CHECK=" (if ok "PASS" "FAIL")))
  (println (str "SELFHOST_RUN=" (if ok "PASS" "FAIL")))
  (if ok
    (println "SELFHOST_SMOKE=PASS")
    (do (println "SELFHOST_SMOKE=FAIL") (throw "selfhost-smoke-failed"))))
