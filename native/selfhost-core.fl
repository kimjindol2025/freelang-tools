;; FreeLang-native AFJ runner smoke.

(let [runner (shell_env "FL_TOOLS_SELFHOST_RUNNER")
      probe (shell_env "FL_TOOLS_SELFHOST_PROBE")
      check (try (shell-safe "node" [runner "check" probe]) (catch error ""))
      run (try (shell-safe "node" [runner "run" probe]) (catch error ""))
      check-ok (str-contains-in check "문법 이상 없음")
      run-ok (str-contains-in run "SELFHOST_PROBE=PASS")]
  (println (str "SELFHOST_CHECK=" (if check-ok "PASS" "FAIL")))
  (println (str "SELFHOST_RUN=" (if run-ok "PASS" "FAIL")))
  (if (and check-ok run-ok)
    (println "SELFHOST_SMOKE=PASS")
    (do (println "SELFHOST_SMOKE=FAIL") (throw "selfhost-smoke-failed"))))
