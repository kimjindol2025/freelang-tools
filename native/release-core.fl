;; FreeLang-native release readiness policy runner.
(load "release-contract.fl")

(let [notes (shell_env "FL_TOOLS_RELEASE_NOTES")
      git (shell_env "FL_TOOLS_RELEASE_GIT")
      clean (shell_env "FL_TOOLS_RELEASE_CLEAN")
      tags (shell_env "FL_TOOLS_RELEASE_TAGS")
      fields (shell_env "FL_TOOLS_RELEASE_FIELDS")
      contracts (shell_env "FL_TOOLS_RELEASE_CONTRACTS")
      ready (and (= notes "PASS") (= git "PASS") (yes? clean)
                 (= fields "PASS") (= contracts "PASS"))]
  (println (str "RELEASE_NOTES=" notes))
  (println (str "GIT=" git))
  (if (yes? clean) (println "WORKTREE=CLEAN") (println "WORKTREE=CLEAN_REQUIRED"))
  (println (str "TAGS=" tags))
  (println (str "RELEASE_FIELDS=" fields))
  (println (str "NATIVE_CONTRACTS=" contracts))
  (if ready
    (println "RELEASE_READY=YES")
    (do (println "RELEASE_READY=NO") (throw "release-not-ready"))))
