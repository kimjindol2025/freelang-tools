;; FreeLang-native Git read contract.
;; Git is executed through AFJ's capability-gated native-git API.

(defn result-ok? [result]
  {:context "Check a native Git Result"
   :returns "boolean"
   :effects []}
  (= (get result "_tag") "Ok"))

(defn result-value [result]
  {:context "Read the value of a native Git Result"
   :returns "Git value"
   :effects []}
  (if (result-ok? result) (get result "value") nil))

(defn result-error [result]
  {:context "Read the error of a native Git Result"
   :returns "Git error"
   :effects []}
  (if (result-ok? result) nil (get result "code")))

(defn git-result [result]
  {:context "Create a stable Git standard-library result"
   :returns "git result map"
   :effects []}
  {"ok" (result-ok? result)
   "status" (if (result-ok? result) "PASS" "FAIL")
   "value" (result-value result)
   "error" (result-error result)})

(capability-list)
(capability-enable "native-git")

(let [root (shell_env "FL_TOOLS_GIT_ROOT")
      status (git-result (git_status root))
      head (git-result (git_head root))
      branch (git-result (git_branch root))
      diff (git-result (git_diff_name_only root))
      result {"schemaVersion" "freelang.git/v1"
              "source" "freelang-native"
              "root" root
              "status" status
              "head" head
              "branch" branch
              "diff" diff
              "readOnly" true}]
  (println (json-stringify result))
  (println (str "GIT_NATIVE=" (if (and (get status "ok") (get head "ok")) "PASS" "FAIL"))))
