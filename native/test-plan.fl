;; FreeLang-native test execution plan.
;; Host shell remains responsible only for invoking each selected test process.

(let [root (shell_env "FL_TOOLS_TEST_PLAN_ROOT")
      testRoot (shell_env "FL_TOOLS_TEST_PLAN_TEST_ROOT")
      live-url (shell_env "FL_TOOLS_HTTP_TEST_URL")
      include-live (= (shell_env "FL_TOOLS_INCLUDE_LIVE_TESTS") "YES")
      names (if (and (string? testRoot) (file-exists testRoot))
              (sort (filter (fn [name]
                              (and (str-ends-with name ".test.fl")
                                   (or (not (str-ends-with name "-live.test.fl"))
                                       include-live
                                       (and (string? live-url) (not= live-url "")))))
                            (dir-list testRoot)))
              [])
      listing (str-join "\n" (map (fn [name] (str testRoot "/" name)) names))]
  (println "PLAN_SCHEMA=freelang.test-plan/v1")
  (println "PLAN_ACTION=test")
  (println (str "ROOT=" root))
  (println (str "TEST_ROOT=" testRoot))
  (println (str "TEST_FILES=" listing)))
