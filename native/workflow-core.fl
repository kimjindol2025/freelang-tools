;; FreeLang-native validator for external npm/Vitest/Jest workflow evidence.
(load "../src/test/workflow.fl")
(let [input-path (shell_env "FL_TOOLS_WORKFLOW_INPUT")
      input (if (and (string? input-path) (file-exists input-path))
              (json-parse (file-read input-path)) {})
      result (workflow-contract input)]
  (println (json-stringify result))
  (println (str "WORKFLOW_VALID=" (if (= (get result "valid") true) "YES" "NO"))))
