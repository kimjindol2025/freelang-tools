;; FreeLang-native effect capability probe decision.

(let [check-code (str-to-num (shell_env "FL_TOOLS_EFFECT_CHECK_CODE"))
      api-code (str-to-num (shell_env "FL_TOOLS_EFFECT_API_CODE"))
      run-code (str-to-num (shell_env "FL_TOOLS_EFFECT_RUN_CODE"))
      api-path (shell_env "FL_TOOLS_EFFECT_API_OUTPUT")
      run-path (shell_env "FL_TOOLS_EFFECT_RUN_OUTPUT")
      api (try (json-parse (file-read api-path)) (catch error nil))
      api-valid (and (map? api) (boolean? (get api "found")))
      available (and api-valid (get api "found"))
      body-ran (and (file-exists run-path)
                    (> (length (filter (fn [line]
                                        (= (str-trim line) "EFFECT_TAPE_PROBE_BODY_EXECUTED"))
                                      (str-split (file-read run-path) "\n"))) 0))]
  (println (str "API_DOC_STATUS=" (if available "AVAILABLE" "UNAVAILABLE")))
  (if (not= check-code 0)
    (do (println "EFFECT_TAPE_PROBE=ERROR") (throw "effect-probe-check-failed"))
    (if (> api-code 1)
      (do (println "EFFECT_TAPE_PROBE=ERROR")
          (println "CAUSE=effect-api-doc-command-failed")
          (throw "effect-api-doc-failed"))
      (if (not api-valid)
        (do (println "EFFECT_TAPE_PROBE=ERROR")
            (println "CAUSE=invalid-effect-api-doc-json")
            (throw "invalid-effect-api-doc-json"))
        (if (and available (not= run-code 0))
          (do (println "EFFECT_TAPE_PROBE=ERROR")
              (println "CAUSE=declared-effect-api-failed-at-runtime")
              (throw "effect-api-runtime-failed"))
          (if available
            (if body-ran
              (do (println "EFFECT_TAPE_PROBE=SUPPORTED"))
              (do (println "EFFECT_TAPE_PROBE=ERROR")
                  (println "CAUSE=effect-api-run-produced-no-observable-body")
                  (throw "effect-body-not-observed")))
            (if (= run-code 0)
              (do (println "EFFECT_TAPE_PROBE=ERROR")
                  (println "CAUSE=runtime-succeeded-while-api-doc-denied-capability")
                  (throw "effect-capability-contract-failed"))
              (if body-ran
                (do (println "EFFECT_TAPE_PROBE=ERROR")
                    (println "CAUSE=probe-body-ran-before-capability-confirmation")
                    (throw "effect-body-ran-before-capability"))
                (do (println "EFFECT_TAPE_PROBE=BLOCKED")
                    (println "CAUSE=runtime-did-not-expose-a-public-effect-tape-api"))))))))))
