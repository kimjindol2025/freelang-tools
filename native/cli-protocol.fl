;; FreeLang-native CLI final marker protocol.
;; Process execution remains a host boundary; marker semantics live here.

(defn lines-with-prefix [text prefix]
  {:context "Collect exact protocol marker lines"
   :returns "marker lines"
   :effects []}
  (filter (fn [line] (str-starts-with line prefix)) (str-split text "\n")))

(let [stdout-path (shell_env "FL_TOOLS_CLI_STDOUT")
      final-path (shell_env "FL_TOOLS_CLI_FINAL")
      stdout (if (file-exists stdout-path) (file-read stdout-path) "")
      result-prefix "FREELANG_FINAL_RESULT="
      exit-prefix "FREELANG_EXIT_CODE="
      complete-prefix "FREELANG_FINAL_COMPLETE=1"
      result-lines (lines-with-prefix stdout result-prefix)
      exit-lines (lines-with-prefix stdout exit-prefix)
      complete-lines (lines-with-prefix stdout complete-prefix)
      valid (and (= (length result-lines) 1)
                 (= (length exit-lines) 1)
                 (= (length complete-lines) 1))]
  (if valid
    (let [result-line (first result-lines)
          exit-line (first exit-lines)
          result-json (str-slice result-line (length result-prefix))
          exit-code (str-slice exit-line (length exit-prefix))]
      (file-write final-path result-json)
      (println "CLI_PROTOCOL=PASS")
      (println (str "CLI_EXIT_MARKER=" exit-code)))
    (do
      (println (str "CLI_PROTOCOL=FAIL result=" (length result-lines)
                    " exit=" (length exit-lines)
                    " complete=" (length complete-lines)))
      (throw "incomplete-final-protocol"))))
