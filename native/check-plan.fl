;; FreeLang-native check execution plan.
;; The host only supervises the actual runner process.

(defn plan-dialect [value]
  {:context "Normalize the detected dialect for a check plan"
   :returns "dialect string"
   :effects []}
  (if (and (string? value) (not= value "")) value "UNKNOWN"))

(defn plan-runner [value]
  {:context "Normalize the selected runner path for a check plan"
   :returns "runner path or none"
   :effects []}
  (if (and (string? value) (not= value "")) value "none"))

(defn fl-files [directory]
  {:context "List direct FreeLang source files from one declared source directory"
   :returns "absolute source paths"
   :effects ["directory-read" "file-read"]}
  (if (file-exists directory)
    (map (fn [name] (str directory "/" name))
         (sort (filter (fn [name] (str-ends-with name ".fl"))
                       (dir-list directory))))
    []))

(let [root (shell_env "FL_TOOLS_PLAN_ROOT")
      dialectValue (plan-dialect (shell_env "FL_TOOLS_PLAN_DIALECT"))
      runnerValue (plan-runner (shell_env "FL_TOOLS_PLAN_RUNNER"))
      sourceListing (if (or (= dialectValue "AFJ") (= dialectValue "TOOLS"))
                      (str-join "\n" (sort (concat (fl-files (str root "/src"))
                                                   (concat (fl-files (str root "/native"))
                                                           (fl-files root)))))
                      (if (= dialectValue "AIRC")
                        (str-join "\n" (fl-files root))
                        ""))]
  (println "PLAN_SCHEMA=freelang.execution-plan/v1")
  (println "PLAN_ACTION=check")
  (println (str "ROOT=" root))
  (println (str "DIALECT=" dialectValue))
  (println (str "RUNNER=" runnerValue))
  (println (str "SOURCES=" sourceListing)))
