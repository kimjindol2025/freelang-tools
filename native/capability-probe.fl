;; FreeLang Tools native capability probe.
;; Output is one JSON document consumed by AI/CI.
(load "capability-contract.fl")

(capability-list)
(capability-enable "native-process")
(capability-enable "native-git")

(let [json-value (json-parse "{\"ok\":true}")
      process-value (process_spawn "true" [])
      root (shell_cwd)
      git-value (git_status root)
      directory-value (dir-list root)
      schema-value (and (map? json-value)
                        (= (get json-value "ok") true))
      checks [(capability-check "file-read" "file.read" (file-exists "/tmp") "native")
              (capability-check "file-write" "file.write" (boolean? (file-exists "/tmp")) "native")
              (capability-check "json" "json.parse-stringify" (map? json-value) "native")
              (capability-check "environment" "env.read" (string? (shell_env "PATH")) "native")
              (capability-check "clock" "time.now" (number? (now-ms)) "native")
              (capability-check "process-capture" "process.capture"
                                (and (= (get process-value "_tag") "Ok")
                                     (= (get (get process-value "value") "code") 0))
                                "native")
              (capability-check "git" "git.read" (= (get git-value "_tag") "Ok") "native")
              (capability-check "directory-walk" "fs.walk" (> (length directory-value) 0) "native")
              (capability-check "json-contract" "json.contract" schema-value "native")]
      blocked (filter (fn [item] (= (get item "status") "BLOCKED")) checks)
      overall (if (= (length blocked) 0) "PASS" "PARTIAL")]
  (println (json-stringify
             {"schemaVersion" "freelang.capabilities/v1"
              "runtime" "AFJ"
              "root" (shell_cwd)
              "overall" overall
              "checks" checks
              "blockedCount" (length blocked)})))
