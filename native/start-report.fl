;; FreeLang-native start context report.
;; Host supplies observations; native owns field names and readiness contract.

(let [project (shell_env "FL_TOOLS_START_PROJECT")
      dialect (shell_env "FL_TOOLS_START_DIALECT")
      runtime (shell_env "FL_TOOLS_START_RUNTIME")
      entrypoint (shell_env "FL_TOOLS_START_ENTRYPOINT")
      runner (shell_env "FL_TOOLS_START_RUNNER")
      target (shell_env "FL_TOOLS_START_TARGET")
      build (shell_env "FL_TOOLS_START_BUILD")
      docs (shell_env "FL_TOOLS_START_DOCS")
      git (shell_env "FL_TOOLS_START_GIT")
      branch (shell_env "FL_TOOLS_START_BRANCH")
      doctor (shell_env "FL_TOOLS_START_DOCTOR")]
  (println (str "PROJECT=" project))
  (println (str "LANGUAGE=" dialect))
  (println "FAMILY=FreeLang")
  (println (str "RUNTIME=" runtime))
  (println (str "ENTRYPOINT=" entrypoint))
  (println (str "RUNNER=" runner))
  (println (str "TEST_COMMAND=fl-tools test " target))
  (println (str "CHECK_COMMAND=fl-tools check " target))
  (println (str "BUILD_COMMAND=" build))
  (println (str "DOCUMENTS=" docs))
  (println (str "GIT=" git))
  (println (str "CURRENT_BRANCH=" branch))
  (if (and (= doctor "PASS") (not= dialect "UNKNOWN") (not= git "not-a-repository"))
    (println "READY=YES")
    (println "READY=NO")))
