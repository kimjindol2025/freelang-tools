;; Native FreeLang tests for release readiness policy primitives.
(load "../src/test/deftest-runner.fl")
(load "../native/release-contract.fl")

(deftest "YES is affirmative" (is= true (yes? "YES")))
(deftest "other values are not affirmative" (is= false (yes? "NO")))
(deftest "release fields detect contract" (is= true
  (contains-any? "CHANGELOG.md tag artifact-hash" ["CHANGELOG" "artifact-hash"])))
(deftest "release fields reject missing contract" (is= false
  (contains-any? "notes only" ["CHANGELOG" "artifact-hash"])))

(run-deftest-suite)
