;; Phase 3 native reporter tests.
(load "../src/test/result.fl")
(load "../src/test/report.fl")

(define pass-run
  (result-aggregate
    [(test-result "math" "add" "PASS" 1)
     (test-result "math" "even" "PASS" 1)]
    2))

(define blocked-run
  (result-aggregate
    [(test-result "effects" "write" "BLOCKED" 0)]
    1))

(define error-run
  (result-aggregate
    [(test-result "math" "broken" "ERROR" 0)]
    1))

(define not-run
  (result-aggregate
    [(test-result "math" "skip" "SKIPPED" 0)]
    1))

(deftest "summary preserves pass counts and status" (is= "PASS"
  (get (report-summary pass-run) "status")))
(deftest "pass report carries exit zero" (is= 0
  (get (report-summary pass-run) "exit_code")))
(deftest "summary preserves blocked status" (is= "BLOCKED"
  (get (report-summary blocked-run) "status")))
(deftest "blocked report carries exit two" (is= 2
  (get (report-summary blocked-run) "exit_code")))
(deftest "json report round trips status" (is= "PASS"
  (get (json-parse (report-json pass-run)) "status")))
(deftest "json report keeps non-pass status" (is= "BLOCKED"
  (get (json-parse (report-json blocked-run)) "status")))
(deftest "json report keeps error status and count" (is= 1
  (get (json-parse (report-json error-run)) "error_count")))
(deftest "json report keeps not-run status" (is= "NOT_RUN"
  (get (json-parse (report-json not-run)) "status")))
(deftest "not-run report carries exit three" (is= 3
  (get (report-summary not-run) "exit_code")))
(deftest "text report exposes counts and status" (is= true
  (and (contains? (report-text pass-run) "status=PASS")
       (contains? (report-text pass-run) "expected=2")
       (contains? (report-text pass-run) "2 passed"))))

(run-tests)
