#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
TOOLS_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
ACTION="ready"
TARGET=""
DEEP=NO

while [[ $# -gt 0 ]]; do
  case "$1" in
    ready|start|work|run|verify|release|trust|review) ACTION="$1" ;;
    --deep) DEEP=YES ;;
    --help|-h) echo "사용법: fl-tools ai [ready|work|verify|release] [--deep] [경로]"; exit 0 ;;
    *) TARGET="$1" ;;
  esac
  shift
done

if [[ -z "$TARGET" ]]; then
  TARGET="$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)"
fi

TMP_DIR="$(mktemp -d)"
cleanup() { rm -rf "$TMP_DIR"; }
trap cleanup EXIT INT TERM

TOOL_AUDIT_STATUS=NOT_RUN
TOOL_AUDIT_FILE=""
if [[ "$DEEP" == YES || "$ACTION" == release ]]; then
  mkdir -p -- "$TARGET/.freelang/evidence"
  TOOL_AUDIT_FILE="$TARGET/.freelang/evidence/tester-audit-latest.json"
  set +e
  "$TOOLS_ROOT/scripts/fl-native-tester-audit" --run --output "$TOOL_AUDIT_FILE" \
    >"$TMP_DIR/tester-audit.out" 2>&1
  TOOL_AUDIT_CODE=$?
  set -e
  TOOL_AUDIT_VERDICT="$(sed -n 's/.*"verdict":"\([^"]*\)".*/\1/p' "$TMP_DIR/tester-audit.out" | tail -1)"
  case "$TOOL_AUDIT_VERDICT" in
    PASS)
      [[ "$TOOL_AUDIT_CODE" -eq 0 ]] && TOOL_AUDIT_STATUS=PASS || TOOL_AUDIT_STATUS=FAIL
      ;;
    UNRESOLVED|BLOCKED)
      TOOL_AUDIT_STATUS=BLOCKED
      ;;
    *)
      [[ "$TOOL_AUDIT_CODE" -eq 2 ]] && TOOL_AUDIT_STATUS=BLOCKED || TOOL_AUDIT_STATUS=FAIL
      ;;
  esac
fi

CODE=0
INPUT="$TMP_DIR/input.json"
PERSIST=NO
if [[ "$ACTION" == ready || "$ACTION" == start || "$ACTION" == work ]]; then
  set +e
  "$TOOLS_ROOT/scripts/fl-ready" "$TARGET" >"$INPUT" 2>"$TMP_DIR/input.err"
  CODE=$?
  set -e
  [[ "$ACTION" == work ]] && PERSIST=YES
elif [[ "$ACTION" == run ]]; then
  READY_INPUT="$TMP_DIR/ready.json"
  set +e
  "$TOOLS_ROOT/scripts/fl-ready" "$TARGET" >"$READY_INPUT" 2>"$TMP_DIR/ready.err"
  READY_CODE=$?
  set -e
  if [[ "$READY_CODE" -ne 0 ]]; then
    INPUT="$READY_INPUT"
    CODE="$READY_CODE"
  else
    MODE_ARG=--quick
    [[ "$DEEP" == YES ]] && MODE_ARG=""
    set +e
    if [[ -n "$MODE_ARG" ]]; then
      "$TOOLS_ROOT/scripts/fl-trust" --quick "$TARGET" >"$INPUT" 2>"$TMP_DIR/input.err"
    else
      "$TOOLS_ROOT/scripts/fl-trust" "$TARGET" >"$INPUT" 2>"$TMP_DIR/input.err"
    fi
    CODE=$?
    set -e
  fi
  PERSIST=YES
else
  MODE_ARG=--quick
  if [[ "$DEEP" == YES || "$ACTION" == release ]]; then MODE_ARG=""; fi
  set +e
  if [[ -n "$MODE_ARG" ]]; then
    "$TOOLS_ROOT/scripts/fl-trust" --quick "$TARGET" >"$INPUT" 2>"$TMP_DIR/input.err"
  else
    "$TOOLS_ROOT/scripts/fl-trust" "$TARGET" >"$INPUT" 2>"$TMP_DIR/input.err"
  fi
  CODE=$?
  set -e
  PERSIST=YES
fi

set +e
"$TOOLS_ROOT/scripts/fl-ai-protocol" "$INPUT" "$ACTION" "$TARGET" "$CODE" "$DEEP" "$PERSIST" "$TOOL_AUDIT_STATUS" "$TOOL_AUDIT_FILE"
PROTOCOL_CODE=$?
set -e
exit "$PROTOCOL_CODE"
