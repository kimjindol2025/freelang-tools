#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
TOOLS_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
RESULT_PATH="${1:-}"
EXIT_MARKER="${2:-}"
PROCESS_EXIT="${3:-}"
RUNNER="${FREELANG_CGC_RUN:-$TOOLS_ROOT/scripts/fl-cgc-run}"

if [[ -z "$RESULT_PATH" || -z "$EXIT_MARKER" || -z "$PROCESS_EXIT" || ! -f "$RESULT_PATH" || ! -f "$RUNNER" ]]; then
  echo "PROTOCOL_ERROR=missing-input-or-runner" >&2
  exit 2
fi

OUTPUT="$(FL_TOOLS_PROTOCOL_RESULT="$RESULT_PATH" \
  FL_TOOLS_PROTOCOL_EXIT_MARKER="$EXIT_MARKER" \
  FL_TOOLS_PROTOCOL_PROCESS_EXIT="$PROCESS_EXIT" \
  "$TOOLS_ROOT/scripts/protocol-check-native")"

if grep -q '^PROTOCOL_ERROR=' <<<"$OUTPUT"; then
  printf '%s\n' "$OUTPUT" >&2
  exit 2
fi

printf '%s\n' "$OUTPUT"
