#!/usr/bin/env bash
set -Eeuo pipefail
SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
TOOLS_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
ROOT="${1:?root required}"
ALL_TESTS="${2:-NO}"
[[ -d "$ROOT" && -x "$TOOLS_ROOT/scripts/workflow-plan-native" ]] || exit 2
FL_TOOLS_WORKFLOW_ROOT="$ROOT" FL_TOOLS_WORKFLOW_ALL_TESTS="$ALL_TESTS" \
  "$TOOLS_ROOT/scripts/workflow-plan-native"
