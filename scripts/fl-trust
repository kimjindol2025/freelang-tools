#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
TOOLS_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
TARGET="${1:-.}"
MODE=deep
if [[ "${1:-}" == "--quick" ]]; then
  MODE=quick
  shift
  TARGET="${1:-.}"
fi

if [[ ! -d "$TARGET" ]]; then
  node - "$TARGET" <<'NODE'
const target = process.argv[2];
process.stdout.write(JSON.stringify({
  schemaVersion: 'freelang.trust/v1', generatedAt: new Date().toISOString(), verdict: 'BLOCKED',
  project: { name: '', root: target, dialect: 'UNKNOWN', runner: 'none' },
  git: { branch: 'none', commit: 'none', state: 'unknown' },
  gates: { check: 'BLOCKED', test: 'BLOCKED', review: 'BLOCKED', evidence: 'BLOCKED', diffCheck: 'BLOCKED', workflow: 'BLOCKED', capabilityCoverage: 'UNKNOWN' },
  decision: { source: 'unavailable', command: 'trust-core' },
  approvalRequired: false,
  limitations: ['project directory not found'],
  evidence: { commands: ['fl-tools trust ' + target], artifacts: ['schemas/trust.schema.json'] },
  next: 'fix-blocked-gates-and-rerun-trust'
}, null, 2) + '\n');
NODE
  exit 2
fi

ROOT="$(cd -- "$TARGET" && pwd -P)"
TMP_DIR="$(mktemp -d)"
cleanup() { rm -rf "$TMP_DIR"; }
trap cleanup EXIT INT TERM

run_gate() {
  local name="$1"
  shift
  local output="$TMP_DIR/$name.out"
  local code=0
  set +e
  timeout "${FREELANG_TRUST_TIMEOUT:-120}" "$@" >"$output" 2>&1
  code=$?
  set -e
  printf '%s' "$code" > "$TMP_DIR/$name.code"
}

DETECT_OUTPUT="$($TOOLS_ROOT/scripts/fl-detect "$ROOT" 2>"$TMP_DIR/detect.err" || true)"
PROJECT="$(printf '%s\n' "$DETECT_OUTPUT" | sed -n 's/^PROJECT=//p')"
DIALECT="$(printf '%s\n' "$DETECT_OUTPUT" | sed -n 's/^DIALECT=//p')"
RUNNER="$(printf '%s\n' "$DETECT_OUTPUT" | sed -n 's/^RUNNER=//p')"

if [[ "$MODE" == quick ]]; then
  run_gate check env FREELANG_CHECK_QUICK=YES "$TOOLS_ROOT/scripts/fl-check" "$ROOT"
else
  run_gate check "$TOOLS_ROOT/scripts/fl-check" "$ROOT"
fi
if [[ "$MODE" == quick ]]; then
  printf '3' > "$TMP_DIR/test.code"
  printf 'TEST=NOT_RUN\n' > "$TMP_DIR/test.out"
  printf '3' > "$TMP_DIR/review.code"
  printf 'REVIEW=NOT_RUN\nDIFF_CHECK=PASS\n' > "$TMP_DIR/review.out"
  printf '3' > "$TMP_DIR/evidence.code"
  printf 'EVIDENCE=NOT_RUN\n' > "$TMP_DIR/evidence.out"
  printf '3' > "$TMP_DIR/capabilities.code"
  printf 'CAPABILITIES=NOT_RUN\n' > "$TMP_DIR/capabilities.out"
  printf '0' > "$TMP_DIR/workflow.code"
  printf 'WORKFLOW_TEST=NOT_APPLICABLE\n' > "$TMP_DIR/workflow.out"
else
  if [[ "$DIALECT" == "NODE" ]]; then
    run_gate test "$TOOLS_ROOT/scripts/fl-workflow-test" "$ROOT"
  else
    run_gate test "$TOOLS_ROOT/scripts/fl-test" "$ROOT"
  fi
  run_gate review "$TOOLS_ROOT/scripts/fl-review" "$ROOT"
  run_gate evidence "$TOOLS_ROOT/scripts/fl-evidence" --json "$ROOT"
  run_gate capabilities "$TOOLS_ROOT/scripts/fl-capabilities" "$ROOT"
  if [[ "$DIALECT" == "NODE" ]]; then
    run_gate workflow "$TOOLS_ROOT/scripts/fl-workflow-test" --workflows "$ROOT"
  else
    printf '0' > "$TMP_DIR/workflow.code"
    printf 'WORKFLOW_TEST=NOT_APPLICABLE\n' > "$TMP_DIR/workflow.out"
  fi
fi

CHECK_CODE="$(cat "$TMP_DIR/check.code")"
TEST_CODE="$(cat "$TMP_DIR/test.code")"
REVIEW_CODE="$(cat "$TMP_DIR/review.code")"
EVIDENCE_CODE="$(cat "$TMP_DIR/evidence.code")"
CAPABILITY_CODE="$(cat "$TMP_DIR/capabilities.code")"
WORKFLOW_CODE="$(cat "$TMP_DIR/workflow.code")"
CHECK_STATUS=FAIL; TEST_STATUS=FAIL; REVIEW_STATUS=FAIL; EVIDENCE_STATUS=FAIL; DIFF_STATUS=FAIL
WORKFLOW_STATUS=NOT_APPLICABLE
CAPABILITY_STATUS=UNKNOWN
if [[ "$MODE" == quick ]]; then
  TEST_STATUS=NOT_RUN
  REVIEW_STATUS=NOT_RUN
  EVIDENCE_STATUS=NOT_RUN
  CAPABILITY_STATUS=NOT_RUN
fi
if [[ "$CHECK_CODE" -eq 0 ]]; then CHECK_STATUS=PASS; fi
if [[ "$TEST_CODE" -eq 0 ]]; then TEST_STATUS=PASS; fi
if [[ "$CHECK_CODE" -eq 2 ]]; then CHECK_STATUS=BLOCKED; fi
if [[ "$TEST_CODE" -eq 2 ]]; then TEST_STATUS=BLOCKED; fi
if grep -q '^REVIEW=PASS$' "$TMP_DIR/review.out"; then REVIEW_STATUS=PASS; fi
if grep -q '^REVIEW=PASS_WITH_APPROVAL$' "$TMP_DIR/review.out"; then REVIEW_STATUS=PASS_WITH_APPROVAL; fi
if [[ "$EVIDENCE_CODE" -eq 0 ]]; then EVIDENCE_STATUS=PASS; fi
if [[ "$EVIDENCE_CODE" -eq 2 ]]; then EVIDENCE_STATUS=BLOCKED; fi
if grep -q '^DIFF_CHECK=PASS$' "$TMP_DIR/review.out"; then DIFF_STATUS=PASS; fi
if grep -q '^WORKFLOW_TEST=PASS$' "$TMP_DIR/workflow.out"; then WORKFLOW_STATUS=PASS; fi
if grep -q '^WORKFLOW_TEST=BLOCKED$' "$TMP_DIR/workflow.out"; then WORKFLOW_STATUS=BLOCKED; fi

if grep -q '^CAPABILITIES=BLOCKED$' "$TMP_DIR/capabilities.out"; then
  CAPABILITY_STATUS=PARTIAL
elif [[ "$CAPABILITY_CODE" -eq 0 ]]; then
  CAPABILITY_STATUS=FULL
fi

APPROVAL_REQUIRED=false
grep -q '^APPROVAL_REQUIRED=YES$' "$TMP_DIR/review.out" && APPROVAL_REQUIRED=true
grep -q '^CONTRACT=LEGACY_VALID$' "$TMP_DIR/evidence.out" && APPROVAL_REQUIRED=true || true

GIT_BRANCH=none
GIT_COMMIT=none
GIT_STATE=not-a-repository
if git -C "$ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  GIT_BRANCH="$(git -C "$ROOT" branch --show-current)"
  GIT_COMMIT="$(git -C "$ROOT" rev-parse HEAD)"
  GIT_STATE=clean
  if [[ -n "$(git -C "$ROOT" status --short)" ]]; then GIT_STATE=dirty; fi
fi

LIMITATIONS_JSON='[]'
if [[ "$CAPABILITY_STATUS" == PARTIAL ]]; then
  LIMITATIONS_JSON='["capability probe is currently AFJ-only; this project capability surface was not fully exercised"]'
elif [[ "$CAPABILITY_STATUS" == UNKNOWN ]]; then
  LIMITATIONS_JSON='["capability coverage could not be established"]'
fi
if [[ "$REVIEW_STATUS" == PASS_WITH_APPROVAL ]]; then
  LIMITATIONS_JSON="$(node -e 'const a=JSON.parse(process.argv[1]); a.push("review detected contract/spec drift; explicit approval is required before deploy"); process.stdout.write(JSON.stringify(a))' "$LIMITATIONS_JSON")"
fi

FREELANG_TRUST_MODE="$MODE" node - "$TMP_DIR/decision-input.json" "$PROJECT" "$CHECK_STATUS" "$TEST_STATUS" \
  "$REVIEW_STATUS" "$EVIDENCE_STATUS" "$DIFF_STATUS" "$WORKFLOW_STATUS" "$APPROVAL_REQUIRED" <<'NODE'
const fs = require('fs');
const [file, project, check, test, review, evidence, diffCheck, workflow, approval] = process.argv.slice(2);
fs.writeFileSync(file, JSON.stringify({
  project, check, test, review, evidence, diffCheck, workflow,
  mode: process.env.FREELANG_TRUST_MODE || 'deep',
  approvalRequired: approval === 'true'
}) + '\n');
NODE
run_gate native_decision "$TOOLS_ROOT/scripts/fl-native-trust" --input "$TMP_DIR/decision-input.json"
NATIVE_CODE="$(cat "$TMP_DIR/native_decision.code")"
NATIVE_VERDICT=BLOCKED
NATIVE_SOURCE=unavailable
if [[ "$NATIVE_CODE" -eq 0 ]]; then
  NATIVE_VERDICT="$(node -e 'const x=JSON.parse(process.argv[1]); process.stdout.write(x.verdict)' "$(cat "$TMP_DIR/native_decision.out")")"
  NATIVE_SOURCE=freelang-native
fi

FL_TOOLS_TRUST_REPORT_ROOT="$ROOT" \
FL_TOOLS_TRUST_REPORT_PROJECT="$PROJECT" \
FL_TOOLS_TRUST_REPORT_DIALECT="$DIALECT" \
FL_TOOLS_TRUST_REPORT_RUNNER="$RUNNER" \
FL_TOOLS_TRUST_REPORT_BRANCH="$GIT_BRANCH" \
FL_TOOLS_TRUST_REPORT_COMMIT="$GIT_COMMIT" \
FL_TOOLS_TRUST_REPORT_GIT_STATE="$GIT_STATE" \
FL_TOOLS_TRUST_REPORT_CHECK="$CHECK_STATUS" \
FL_TOOLS_TRUST_REPORT_TEST="$TEST_STATUS" \
FL_TOOLS_TRUST_REPORT_REVIEW="$REVIEW_STATUS" \
FL_TOOLS_TRUST_REPORT_EVIDENCE="$EVIDENCE_STATUS" \
FL_TOOLS_TRUST_REPORT_DIFF="$DIFF_STATUS" \
FL_TOOLS_TRUST_REPORT_WORKFLOW="$WORKFLOW_STATUS" \
FL_TOOLS_TRUST_REPORT_CAPABILITY="$CAPABILITY_STATUS" \
FL_TOOLS_TRUST_REPORT_APPROVAL="$APPROVAL_REQUIRED" \
FL_TOOLS_TRUST_REPORT_LIMITATIONS="$LIMITATIONS_JSON" \
FL_TOOLS_TRUST_REPORT_VERDICT="$NATIVE_VERDICT" \
FL_TOOLS_TRUST_REPORT_SOURCE="$NATIVE_SOURCE" \
  "$TOOLS_ROOT/scripts/fl-trust-report"
REPORT_CODE=$?
printf 'TRUST=%s\n' "$NATIVE_VERDICT" >&2
if [[ "$REPORT_CODE" -ne 0 ]]; then
  exit 1
fi
if [[ "$NATIVE_CODE" -ne 0 || "$NATIVE_VERDICT" == BLOCKED || "$NATIVE_VERDICT" == UNTRUSTED ]]; then
  exit 1
fi
exit 0
