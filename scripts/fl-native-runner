#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
TOOLS_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
MODE="${1:?mode is required}"
TARGET="${2:?target is required}"
if [[ "$MODE" == check ]]; then
  exec "$TOOLS_ROOT/scripts/fl-cgc-check" "$TARGET"
fi
if [[ "$MODE" == run ]]; then
  OUTPUT_PATH="${3:-}"
  if [[ -n "$OUTPUT_PATH" ]]; then
    set +e
    "$TOOLS_ROOT/scripts/fl-cgc-run" "$TARGET" >"$OUTPUT_PATH"
    code=$?
    set -e
    cat "$OUTPUT_PATH"
    exit "$code"
  fi
  exec "$TOOLS_ROOT/scripts/fl-cgc-run" "$TARGET"
fi
echo "RUNNER_NATIVE=BLOCKED" >&2
echo "CAUSE=unsupported-mode: $MODE" >&2
exit 2
