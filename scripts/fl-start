#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
TOOLS_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
TARGET="${1:-.}"

DETECT_OUTPUT="$("$TOOLS_ROOT/scripts/fl-detect" "$TARGET")"
PROJECT_ROOT="$(printf '%s\n' "$DETECT_OUTPUT" | sed -n 's/^ROOT=//p')"
PROJECT="$(printf '%s\n' "$DETECT_OUTPUT" | sed -n 's/^PROJECT=//p')"
DIALECT="$(printf '%s\n' "$DETECT_OUTPUT" | sed -n 's/^DIALECT=//p')"
RUNNER="$(printf '%s\n' "$DETECT_OUTPUT" | sed -n 's/^RUNNER=//p')"

case "$DIALECT" in
  TOOLS) RUNTIME="FreeLang Tools" ;;
  AIRC) RUNTIME="FreeLang v11" ;;
  AIA) RUNTIME=native ;;
  FRONT|AFJ|FX|SCRIPT) RUNTIME=FreeLang ;;
  *) RUNTIME=UNKNOWN ;;
esac

ENTRYPOINT=none
for candidate in \
  scripts/fl-tools \
  airc.fl \
  tools/verify-aia-cold-boot.sh \
  src/main.fl main.fl server.fl web/server.fl \
  aia-seed/aia bin/fl-script-unified.js \
  fl-front-build.js web/fl-front-build.js bootstrap.js; do
  if [[ -e "$PROJECT_ROOT/$candidate" ]]; then
    ENTRYPOINT="$PROJECT_ROOT/$candidate"
    break
  fi
done

TEST_COMMAND="fl-tools test $TARGET"
CHECK_COMMAND="fl-tools check $TARGET"
BUILD_COMMAND=none
if [[ -f "$PROJECT_ROOT/package.json" ]]; then
  if "$TOOLS_ROOT/scripts/fl-native-package-script" "$PROJECT_ROOT" build >/dev/null 2>&1; then
    BUILD_COMMAND="npm run build"
  fi
fi
if [[ "$BUILD_COMMAND" == none && "$DIALECT" == FRONT ]]; then
  BUILD_COMMAND="$RUNNER"
fi

DOCS=0
for doc in README.md AGENTS.md STATUS.md ROADMAP.md CHANGELOG.md SPEC.airc LANGUAGE_LOCK.md; do
  [[ -f "$PROJECT_ROOT/$doc" ]] && DOCS=$((DOCS + 1))
done

GIT=not-a-repository
BRANCH=none
if git -C "$PROJECT_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  BRANCH="$(git -C "$PROJECT_ROOT" branch --show-current)"
  if [[ -n "$(git -C "$PROJECT_ROOT" status --short)" ]]; then GIT=dirty; else GIT=clean; fi
fi

DOCTOR_OUTPUT=""
set +e
DOCTOR_OUTPUT="$($TOOLS_ROOT/scripts/fl-doctor "$PROJECT_ROOT" 2>&1)"
DOCTOR_CODE=$?
set -e

DOCTOR_STATUS=FAIL
[[ "$DOCTOR_CODE" -eq 0 ]] && DOCTOR_STATUS=PASS
FL_TOOLS_START_PROJECT="$PROJECT" \
FL_TOOLS_START_DIALECT="$DIALECT" \
FL_TOOLS_START_RUNTIME="$RUNTIME" \
FL_TOOLS_START_ENTRYPOINT="$ENTRYPOINT" \
FL_TOOLS_START_RUNNER="$RUNNER" \
FL_TOOLS_START_TARGET="$TARGET" \
FL_TOOLS_START_BUILD="$BUILD_COMMAND" \
FL_TOOLS_START_DOCS="$DOCS" \
FL_TOOLS_START_GIT="$GIT" \
FL_TOOLS_START_BRANCH="$BRANCH" \
FL_TOOLS_START_DOCTOR="$DOCTOR_STATUS" \
  "$TOOLS_ROOT/scripts/fl-native-start-report"

if [[ "$DOCTOR_CODE" -ne 0 || "$DIALECT" == UNKNOWN || "$GIT" == not-a-repository ]]; then
  [[ "$DOCTOR_CODE" -ne 0 ]] && printf '%s\n' "$DOCTOR_OUTPUT" >&2
  exit 1
fi
