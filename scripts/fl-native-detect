#!/usr/bin/env bash
set -Eeuo pipefail
SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
TOOLS_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
TARGET="${1:-.}"
if [[ ! -d "$TARGET" ]]; then
  echo "PROJECT_DETECT=BLOCKED"
  echo "CAUSE=directory not found: $TARGET" >&2
  exit 2
fi
ROOT_PATH="$(cd -- "$TARGET" && pwd -P)"
FL_TOOLS_DETECT_ROOT="$ROOT_PATH" "$TOOLS_ROOT/scripts/detect-core-native"
