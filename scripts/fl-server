#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
TOOLS_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
INSTALL_ROOT="${FREELANG_TOOLS_HOME:-${HOME:-}/.local/share/freelang-tools}"
BIN_DIR="${FREELANG_TOOLS_BIN:-${HOME:-}/.local/bin}"

usage() { echo "사용법: fl-tools server [install|status]"; }

status() {
  local ready=1 path_configured=false
  [[ -x "$BIN_DIR/fl-tools" ]] || ready=0
  [[ -x "$BIN_DIR/fl-test" ]] || ready=0
  case ":${PATH:-}:" in *":$BIN_DIR:"*) path_configured=true ;; esac
  set +e
  FL_TOOLS_SERVER_READY="$([[ "$ready" -eq 1 ]] && echo YES || echo NO)" \
  FL_TOOLS_SERVER_PATH_CONFIGURED="$([[ "$path_configured" == true ]] && echo YES || echo NO)" \
  FL_TOOLS_SERVER_INSTALL_ROOT="$INSTALL_ROOT" \
  FL_TOOLS_SERVER_BIN_DIR="$BIN_DIR" \
  FL_TOOLS_SERVER_TOOLS_ROOT="$TOOLS_ROOT" \
    "$TOOLS_ROOT/scripts/server-status-native"
  local code=$?
  set -e
  return "$code"
}

install() {
  if [[ "$TOOLS_ROOT" == "$INSTALL_ROOT/current" ]]; then
    mkdir -p "$BIN_DIR"
    ln -sfn "$TOOLS_ROOT/scripts/fl-tools" "$BIN_DIR/fl-tools"
    ln -sfn "$TOOLS_ROOT/scripts/fl-test" "$BIN_DIR/fl-test"
  else
    "$TOOLS_ROOT/install.sh"
  fi
  status
}

case "${1:-status}" in
  install) install ;;
  status) status ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 2 ;;
esac
