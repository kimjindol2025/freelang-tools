#!/usr/bin/env bash
set -Eeuo pipefail
SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
TOOLS_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
OUTPUT_PATH="${1:?output path required}"
[[ -f "$OUTPUT_PATH" ]] || { echo "TEST_RESULT=FAIL"; exit 2; }
set +e
FL_TOOLS_TEST_OUTPUT="$OUTPUT_PATH" "$TOOLS_ROOT/scripts/test-result-native"
CODE=$?
set -e
exit "$CODE"
