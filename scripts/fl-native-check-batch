#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
TOOLS_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
ROOT="${1:?project root is required}"
DIALECT="${2:?dialect is required}"
RUNNER="${3:-}"

PLAN_OUTPUT="$("$TOOLS_ROOT/scripts/fl-native-check-plan" "$ROOT" "$DIALECT" "${RUNNER:-none}")"
SOURCES_TEXT="$(printf '%s\n' "$PLAN_OUTPUT" | sed -n '/^SOURCES=/,$p' | sed '1s/^SOURCES=//' | sed '/^$/d')"
if [[ -z "$SOURCES_TEXT" ]]; then
  echo "SUPERVISOR_COUNT=0"
  echo "SUPERVISOR_EXIT=0"
  exit 0
fi

failed=0
count=0
while IFS= read -r source; do
  [[ -n "$source" ]] || continue
  count=$((count + 1))
  echo "[fl-check] $source"
  if ! "$TOOLS_ROOT/scripts/fl-cgc-check" "$source"; then
    failed=1
  fi
done <<< "$SOURCES_TEXT"
echo "SUPERVISOR_COUNT=$count"
echo "SUPERVISOR_EXIT=$failed"
exit "$failed"
