#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
TOOLS_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
TARGET="${1:-.}"
ROOT="$(cd -- "$TARGET" && pwd -P)"

if ! git -C "$ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo 'INTERNAL_DEPLOY=BLOCKED'
  echo 'CAUSE=target is not a git worktree'
  exit 2
fi

if [[ -n "$(git -C "$ROOT" status --short)" && "${FREELANG_ALLOW_DIRTY_INTERNAL_DEPLOY:-0}" != 1 ]]; then
  echo 'INTERNAL_DEPLOY=BLOCKED'
  echo 'CAUSE=worktree is dirty; internal deployment requires a fixed commit'
  exit 3
fi

CONTRACT="$ROOT/.freelang/internal-deploy.sh"
if [[ ! -x "$CONTRACT" ]]; then
  echo 'INTERNAL_DEPLOY=BLOCKED'
  echo 'CAUSE=no project internal deploy contract (.freelang/internal-deploy.sh)'
  exit 4
fi

COMMIT="$(git -C "$ROOT" rev-parse HEAD)"
BRANCH="$(git -C "$ROOT" branch --show-current)"
echo "INTERNAL_DEPLOY_ROOT=$ROOT"
echo "INTERNAL_DEPLOY_BRANCH=$BRANCH"
echo "INTERNAL_DEPLOY_COMMIT=$COMMIT"

set +e
(cd "$ROOT" && \
  FREELANG_INTERNAL_COMMIT="$COMMIT" \
  FREELANG_INTERNAL_BRANCH="$BRANCH" \
  "$CONTRACT")
CODE=$?
set -e
if [[ "$CODE" -ne 0 ]]; then
  echo 'INTERNAL_DEPLOY=FAIL'
  exit "$CODE"
fi
echo 'INTERNAL_DEPLOY=PASS'
