#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
TOOLS_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
INPUT="${1:-}"
ACTION="${2:-run}"
TARGET="${3:-.}"
CODE="${4:-0}"
DEEP="${5:-NO}"
PERSIST="${6:-NO}"
TOOL_AUDIT_STATUS="${7:-NOT_RUN}"
TOOL_AUDIT_FILE="${8:-}"

if [[ -z "$INPUT" || ! -f "$INPUT" || ! -x "$TOOLS_ROOT/scripts/ai-protocol-native" ]]; then
  exit 2
fi

OUTPUT="$(FL_TOOLS_AI_INPUT="$INPUT" \
  FL_TOOLS_AI_ACTION="$ACTION" \
  FL_TOOLS_AI_TARGET="$TARGET" \
  FL_TOOLS_AI_CODE="$CODE" \
  FL_TOOLS_AI_DEEP="$DEEP" \
  FL_TOOLS_AI_PERSIST="$PERSIST" \
  FL_TOOLS_AI_TOOL_AUDIT_STATUS="$TOOL_AUDIT_STATUS" \
  FL_TOOLS_AI_TOOL_AUDIT_FILE="$TOOL_AUDIT_FILE" \
  "$TOOLS_ROOT/scripts/ai-protocol-native")"
exit_code="$(sed -n 's/^AI_EXIT_CODE=//p' <<<"$OUTPUT")"
if [[ -z "$exit_code" ]]; then
  exit 2
fi
sed '/^AI_EXIT_CODE=/d' <<<"$OUTPUT"
exit "$exit_code"
