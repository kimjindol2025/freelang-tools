#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
TOOLS_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
LEFT_PATH="${1:-}"
RIGHT_PATH="${2:-}"

if [[ -z "$LEFT_PATH" || -z "$RIGHT_PATH" || ! -f "$LEFT_PATH" || ! -f "$RIGHT_PATH" || ! -x "$TOOLS_ROOT/scripts/determinism-compare-native" ]]; then
  exit 2
fi

OUTPUT="$(FL_TOOLS_DETERMINISM_LEFT="$LEFT_PATH" \
  FL_TOOLS_DETERMINISM_RIGHT="$RIGHT_PATH" \
  "$TOOLS_ROOT/scripts/determinism-compare-native")"
printf '%s\n' "$OUTPUT"
if grep -q '^DETERMINISM_MATCH=final-result$' <<<"$OUTPUT"; then
  exit 0
fi
exit 1
