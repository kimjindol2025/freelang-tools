#!/usr/bin/env bash
set -Eeuo pipefail
SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
TOOLS_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
PROGRAM="${1:-}"
ARGS_JSON="${2:-[]}"
if [[ -z "$PROGRAM" ]]; then
  echo "PROCESS_NATIVE=BLOCKED" >&2
  exit 2
fi
OUTPUT="$(
  FL_TOOLS_PROCESS_PROGRAM="$PROGRAM" \
  FL_TOOLS_PROCESS_ARGS="$ARGS_JSON" \
    "$TOOLS_ROOT/scripts/process-core-native"
)"
printf '%s\n' "$OUTPUT"
if grep -q '"status":"PASS"' <<<"$OUTPUT"; then
  exit 0
fi
exit 1
