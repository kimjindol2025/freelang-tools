#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
TOOLS_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
TARGET="${1:-.}"
ROOT="$(cd -- "$TARGET" && pwd -P)"
FAIL=0
APPROVAL_REQUIRED=NO
HARD_CONTRACT_DRIFT=NO
GATE_LINT_STATUS=NOT_APPLICABLE
GATE_BUILD_STATUS=NOT_APPLICABLE

run_gate() {
  local name="$1"
  shift
  local output code
  set +e
  output="$("$@" 2>&1)"
  code=$?
  set -e
  printf '%s\n' "$output"
  if [[ "$name" == TEST && "$code" -eq 3 ]] && grep -q '^FREELANG_TEST=NOT_RUN$' <<<"$output"; then
    echo "TEST=NOT_RUN"
    FAIL=1
    return
  fi
  if [[ "$code" -eq 0 ]]; then
    echo "$name=PASS"
    printf -v "GATE_${name}_STATUS" '%s' PASS
  else
    echo "$name=FAIL"
    printf -v "GATE_${name}_STATUS" '%s' FAIL
    FAIL=1
  fi
}

if [[ "${FREELANG_TRUST_REUSE_GATE_OUTPUTS:-NO}" == YES && \
      -r "${FREELANG_TRUST_CHECK_OUTPUT_FILE:-}" && \
      -r "${FREELANG_TRUST_TEST_OUTPUT_FILE:-}" && \
      "${FREELANG_TRUST_CHECK_CODE:-invalid}" =~ ^[0-9]+$ && \
      "${FREELANG_TRUST_TEST_CODE:-invalid}" =~ ^[0-9]+$ ]]; then
  cat "$FREELANG_TRUST_CHECK_OUTPUT_FILE"
  if [[ "$FREELANG_TRUST_CHECK_CODE" -eq 0 ]]; then
    echo "CHECK=PASS (reused trust gate)"
    GATE_CHECK_STATUS=PASS
  else
    echo "CHECK=FAIL (reused trust gate)"
    GATE_CHECK_STATUS=FAIL
    FAIL=1
  fi
  cat "$FREELANG_TRUST_TEST_OUTPUT_FILE"
  if [[ "$FREELANG_TRUST_TEST_CODE" -eq 0 ]]; then
    echo "TEST=PASS (reused trust gate)"
    GATE_TEST_STATUS=PASS
  else
    echo "TEST=FAIL (reused trust gate)"
    GATE_TEST_STATUS=FAIL
    FAIL=1
  fi
else
  run_gate CHECK "$TOOLS_ROOT/scripts/fl-check" "$ROOT"
  run_gate TEST "$TOOLS_ROOT/scripts/fl-test" "$ROOT"
fi
run_gate NATIVE_INSPECT "$TOOLS_ROOT/scripts/fl-inspect" "$ROOT"

if [[ -f "$ROOT/package.json" ]] && "$TOOLS_ROOT/scripts/fl-native-package-script" "$ROOT" lint >/dev/null 2>&1; then
  run_gate LINT npm --prefix "$ROOT" run lint
else
  echo "LINT=NOT_APPLICABLE"
fi

if [[ -f "$ROOT/package.json" ]] && "$TOOLS_ROOT/scripts/fl-native-package-script" "$ROOT" build >/dev/null 2>&1; then
  run_gate BUILD npm --prefix "$ROOT" run build
else
  echo "BUILD=NOT_APPLICABLE"
fi

if git -C "$ROOT" diff --check; then
  echo "DIFF_CHECK=PASS"
  GATE_DIFF_STATUS=PASS
else
  echo "DIFF_CHECK=FAIL"
  GATE_DIFF_STATUS=FAIL
  FAIL=1
fi

POLICY_OUTPUT="$($TOOLS_ROOT/scripts/fl-native-review-policy "$ROOT")"
printf '%s\n' "$POLICY_OUTPUT"
GATE_GENERATED_STATUS="$(printf '%s\n' "$POLICY_OUTPUT" | sed -n 's/^GENERATED_FILES=//p')"
GATE_CONTRACT_STATUS=NONE
if [[ "$GATE_GENERATED_STATUS" == DIRTY ]]; then FAIL=1; fi
if grep -q '^CONTRACT_DRIFT_KIND=APPROVAL$' <<<"$POLICY_OUTPUT"; then
  APPROVAL_REQUIRED=YES
  GATE_CONTRACT_STATUS=APPROVAL
elif grep -q '^CONTRACT_DRIFT_KIND=HARD$' <<<"$POLICY_OUTPUT"; then
  HARD_CONTRACT_DRIFT=YES
  GATE_CONTRACT_STATUS=HARD
  FAIL=1
fi

GATE_OUTPUT="$(FL_TOOLS_GATE_CHECK="${GATE_CHECK_STATUS:-FAIL}" \
FL_TOOLS_GATE_TEST="${GATE_TEST_STATUS:-FAIL}" \
FL_TOOLS_GATE_INSPECT="${GATE_NATIVE_INSPECT_STATUS:-FAIL}" \
FL_TOOLS_GATE_LINT="$GATE_LINT_STATUS" \
FL_TOOLS_GATE_BUILD="$GATE_BUILD_STATUS" \
FL_TOOLS_GATE_DIFF="${GATE_DIFF_STATUS:-FAIL}" \
FL_TOOLS_GATE_GENERATED="${GATE_GENERATED_STATUS:-DIRTY}" \
FL_TOOLS_GATE_CONTRACT="${GATE_CONTRACT_STATUS:-HARD}" \
  "$TOOLS_ROOT/scripts/fl-native-gate-report")"
printf '%s\n' "$GATE_OUTPUT"
REVIEW_STATUS="$(printf '%s\n' "$GATE_OUTPUT" | sed -n 's/^REVIEW=//p')"
echo "REGRESSION=$([[ "$REVIEW_STATUS" == FAIL ]] && echo FAIL || echo PASS)"
if [[ "$REVIEW_STATUS" == FAIL ]]; then exit 1; fi
