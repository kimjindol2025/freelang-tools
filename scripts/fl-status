#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
TARGET="${1:-.}"

DETECT_OUTPUT="$($ROOT/scripts/fl-detect "$TARGET")"

TARGET_ROOT="$(printf '%s\n' "$DETECT_OUTPUT" | sed -n 's/^ROOT=//p')"
DIALECT="$(printf '%s\n' "$DETECT_OUTPUT" | sed -n 's/^DIALECT=//p')"

if git -C "$TARGET_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  if [[ -n "$(git -C "$TARGET_ROOT" status --short)" ]]; then
    GIT=dirty
  else
    GIT=clean
  fi
else
  GIT=not-a-repository
fi

RELEASE="UNKNOWN"
if [[ -f "$TARGET_ROOT/CHANGELOG.md" ]]; then
  RELEASE="$(sed -n 's/^## \(v[^ —]*\).*/\1/p' "$TARGET_ROOT/CHANGELOG.md" | head -1)"
fi
RELEASE="${RELEASE:-UNKNOWN}"

set +e
TEST_OUTPUT="$($ROOT/scripts/fl-test "$TARGET_ROOT" 2>&1)"
TEST_CODE=$?
set -e
if [[ "$TEST_CODE" -eq 0 ]]; then
  if grep -q '^FREELANG_TEST=PASS$' <<<"$TEST_OUTPUT"; then
    TEST=PASS
  else
    TEST=NOT_RUN
  fi
elif [[ "$TEST_CODE" -eq 3 ]] && grep -q '^FREELANG_TEST=NOT_RUN$' <<<"$TEST_OUTPUT"; then
  echo "TEST=NOT_RUN"
else
  TEST=FAIL
fi

SELFHOST=NOT_APPLICABLE
COLD_BOOT=NOT_APPLICABLE
case "$DIALECT" in
  AIA)
    if grep -q '^SELFHOST_SMOKE=.*PASS$' <<<"$TEST_OUTPUT"; then
      SELFHOST=PASS
    else
      SELFHOST=UNRESOLVED
    fi
    if grep -q '^GOLDEN=.*PASS$' <<<"$TEST_OUTPUT" && \
       grep -q '^ERRORS=.*PASS$' <<<"$TEST_OUTPUT" && \
       grep -q '^DETERMINISTIC=PASS$' <<<"$TEST_OUTPUT"; then
      COLD_BOOT=PASS
    else
      COLD_BOOT=UNRESOLVED
    fi
    ;;
  FX) SELFHOST=UNRESOLVED; COLD_BOOT=UNRESOLVED ;;
  *) : ;;
esac

FL_TOOLS_STATUS_DETECT="$DETECT_OUTPUT" \
FL_TOOLS_STATUS_PROJECT="$(printf '%s\n' "$DETECT_OUTPUT" | sed -n 's/^PROJECT=//p')" \
FL_TOOLS_STATUS_ROOT="$TARGET_ROOT" \
FL_TOOLS_STATUS_DIALECT="$DIALECT" \
FL_TOOLS_STATUS_GIT="$GIT" \
FL_TOOLS_STATUS_RELEASE="$RELEASE" \
FL_TOOLS_STATUS_TEST="$TEST" \
FL_TOOLS_STATUS_SELFHOST="$SELFHOST" \
FL_TOOLS_STATUS_COLD_BOOT="$COLD_BOOT" \
  "$ROOT/scripts/fl-native-status-report"
