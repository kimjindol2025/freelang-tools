#!/usr/bin/env bash
set -Eeuo pipefail
SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
TOOLS_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
CONTRACT_PATH="${1:?contract path required}"
ACTION="${2:?action required}"
[[ -f "$CONTRACT_PATH" ]] || { echo "CONTRACT=INVALID"; exit 2; }
set +e
FL_TOOLS_CONTRACT_PATH="$CONTRACT_PATH" FL_TOOLS_CONTRACT_ACTION="$ACTION" \
  "$TOOLS_ROOT/scripts/operation-contract-native"
CODE=$?
set -e
exit "$CODE"
