#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
TOOLS_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
TARGET_INPUT="${1:-.}"
shift || true
ROOT="$(cd -- "$TARGET_INPUT" && pwd -P)"
TEST_ROOT="${FREELANG_TEST_ROOT:-$ROOT/tests}"

DETECT_OUTPUT="$($TOOLS_ROOT/scripts/fl-detect "$ROOT")"
DIALECT="$(printf '%s\n' "$DETECT_OUTPUT" | sed -n 's/^DIALECT=//p')"
DETECTED_RUNNER="$(printf '%s\n' "$DETECT_OUTPUT" | sed -n 's/^RUNNER=//p')"
RUNNER="${FREELANG_CGC_RUN:-$TOOLS_ROOT/scripts/fl-cgc-run}"

case "$DIALECT" in
  FRONT)
    FRONT_BUILD="$ROOT/fl-front-build.js"
    FRONT_DIR="$ROOT"
    if [[ ! -f "$FRONT_BUILD" && -f "$ROOT/web/fl-front-build.js" ]]; then
      FRONT_BUILD="$ROOT/web/fl-front-build.js"
      FRONT_DIR="$ROOT/web"
    fi
    if [[ -f "$FRONT_BUILD" ]]; then
      (cd "$FRONT_DIR" && FL_GIT_REPO="${FL_GIT_REPO:-$ROOT}" node fl-front-build.js)
      echo "FREELANG_TEST=PASS"
      exit 0
    fi
    ;;
  SCRIPT)
    SCRIPT_RUNNER="${FREELANG_SCRIPT_RUNNER:-$DETECTED_RUNNER}"
    mapfile -d '' SCRIPT_PRESENT < <(
      find "$TEST_ROOT" -type f \( -name '*.test.fls' -o -name '*.test.fl' \) -print0 2>/dev/null | sort -z
    )
    if [[ ! -f "$SCRIPT_RUNNER" && "${#SCRIPT_PRESENT[@]}" -gt 0 ]]; then
      echo "FREELANG_TEST=BLOCKED"
      echo "CAUSE=SCRIPT runner not found" >&2
      exit 2
    fi
    if [[ -f "$SCRIPT_RUNNER" ]]; then
      SCRIPT_TIMEOUT_MS="${FREELANG_SCRIPT_TEST_TIMEOUT_MS:-15000}"
      if [[ ! "$SCRIPT_TIMEOUT_MS" =~ ^[1-9][0-9]*$ ]]; then
        echo "FREELANG_TEST=BLOCKED"
        echo "CAUSE=FREELANG_SCRIPT_TEST_TIMEOUT_MS must be a positive integer" >&2
        exit 2
      fi
      SCRIPT_TIMEOUT_SECONDS="$(( (SCRIPT_TIMEOUT_MS + 999) / 1000 ))"

      # FreeLangScript projects may keep their executable tests in FreeLang
      # source files.  Run these before the legacy Node test discovery so a
      # project is not rejected merely because it has zero *.test.mjs files.
      mapfile -d '' SCRIPT_NATIVE_TESTS < <(
        find "$TEST_ROOT" -type f \( -name '*.test.fls' -o -name '*.test.fl' \) -print0 | sort -z
      )
      if [[ "${#SCRIPT_NATIVE_TESTS[@]}" -gt 0 ]]; then
        for test_file in "${SCRIPT_NATIVE_TESTS[@]}"; do
          relative="${test_file#"$ROOT/"}"
          echo "[fl-test] check $relative"
          # The Script profile accepts both extensions; `.test.fl` is kept
          # for projects that use the shared FreeLang test naming convention.
          "$TOOLS_ROOT/scripts/script-check-native" "$test_file"
          echo "[fl-test] run $relative"
          timeout "${SCRIPT_TIMEOUT_SECONDS}s" node "$SCRIPT_RUNNER" run "$test_file"
        done
        echo "FREELANG_SCRIPT_TESTS=${#SCRIPT_NATIVE_TESTS[@]}"
        echo "FREELANG_TEST=PASS"
        exit 0
      fi
      echo "FREELANG_TEST=BLOCKED"
      echo "CAUSE=SCRIPT runner present but zero tests executed" >&2
      exit 2
    fi
    ;;
  AIA)
    if [[ -x "$ROOT/tools/verify-aia-cold-boot.sh" ]]; then
      "$ROOT/tools/verify-aia-cold-boot.sh"
      echo "FREELANG_TEST=PASS"
      exit 0
    fi
    ;;
  FX)
    if [[ -x "$ROOT/tests/run-tests.sh" ]]; then
      (cd "$ROOT" && ./tests/run-tests.sh)
      echo "FREELANG_TEST=PASS"
      exit 0
    fi
    ;;
esac

if [[ ! -f "$RUNNER" ]]; then
  echo "FREELANG_TEST=BLOCKED"
  echo "CAUSE=AFJ runner not found: $RUNNER" >&2
  exit 2
fi

if [[ ! -d "$TEST_ROOT" ]]; then
  echo "FREELANG_TEST=NO_TESTS"
  exit 0
fi

OUTPUT_FILE=""
cleanup() {
  rm -f "$OUTPUT_FILE"
}
trap cleanup EXIT INT TERM
PLAN_OUTPUT="$($TOOLS_ROOT/scripts/fl-native-test-plan "$ROOT" "$TEST_ROOT")"
mapfile -t TEST_FILES < <(printf '%s\n' "$PLAN_OUTPUT" | sed -n '/^TEST_FILES=/,$p' | sed '1s/^TEST_FILES=//' | sed '/^$/d')

if [[ "${#TEST_FILES[@]}" -eq 0 ]]; then
  leftover="$(find "$TEST_ROOT" -type f \( -name '*.test.fl' -o -name '*.test.fls' \) 2>/dev/null | wc -l)"
  leftover="${leftover// /}"
  if [[ "$leftover" != "0" ]]; then
    echo "FREELANG_TEST=BLOCKED"
    echo "CAUSE=tests-present-but-none-planned" >&2
    exit 2
  fi
  echo "FREELANG_TEST=NO_TESTS"
  exit 0
fi

for test_file in "${TEST_FILES[@]}"; do
  relative="${test_file#"$ROOT/"}"
  echo "[fl-test] check $relative"
  "$TOOLS_ROOT/scripts/fl-native-runner" check "$test_file"

  rm -f "$OUTPUT_FILE"
  OUTPUT_FILE="$(mktemp)"
  echo "[fl-test] run $relative"
  if ! "$TOOLS_ROOT/scripts/fl-native-runner" run "$test_file" "$OUTPUT_FILE"; then
    cat "$OUTPUT_FILE"
    echo "FREELANG_TEST=FAIL"
    exit 1
  fi
  cat "$OUTPUT_FILE"
  if ! "$TOOLS_ROOT/scripts/fl-native-test-result" "$OUTPUT_FILE"; then
    echo "[fl-test] missing passing summary: $relative" >&2
    echo "FREELANG_TEST=FAIL"
    exit 1
  fi
done

echo "FREELANG_TEST=PASS"
