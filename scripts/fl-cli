#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
TOOLS_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
TARGET_INPUT="${1:-}"
if [[ -z "$TARGET_INPUT" ]]; then
  echo "usage: fl-cli <free-lang-file> [timeout-seconds]" >&2
  exit 2
fi
shift || true
TIMEOUT_SECONDS="${1:-${FREELANG_CLI_TIMEOUT_SECONDS:-8}}"
TARGET="$(readlink -f -- "$TARGET_INPUT")"
RUNNER="${FREELANG_CGC_RUN:-$TOOLS_ROOT/scripts/fl-cgc-run}"
EVIDENCE_DIR="${FREELANG_CLI_EVIDENCE_DIR:-$(mktemp -d "${TMPDIR:-/tmp}/freelang-cli.XXXXXX")}" 
mkdir -p "$EVIDENCE_DIR"

trap 'exit_code=$?; trap - EXIT; "$TOOLS_ROOT/scripts/fl-evidence-manifest" "$EVIDENCE_DIR" "$exit_code" >/dev/null 2>&1 || true; exit "$exit_code"' EXIT

STDOUT_FILE="$EVIDENCE_DIR/stdout.log"
STDERR_FILE="$EVIDENCE_DIR/stderr.log"
CHECK_STDOUT_FILE="$EVIDENCE_DIR/check.stdout.log"
CHECK_STDERR_FILE="$EVIDENCE_DIR/check.stderr.log"
FINAL_FILE="$EVIDENCE_DIR/final-result.json"
META_FILE="$EVIDENCE_DIR/process.meta"

runtime_commit="unknown"
runtime_root="$(cd -- "$(dirname -- "$RUNNER")" && pwd -P)"
if git -C "$runtime_root" rev-parse HEAD >/dev/null 2>&1; then
  runtime_commit="$(git -C "$runtime_root" rev-parse HEAD)"
fi
{
  printf 'TOOL_HEAD=%s\n' "$(git -C "$TOOLS_ROOT" rev-parse HEAD)"
  printf 'RUNTIME=%s\nRUNTIME_COMMIT=%s\nTARGET=%s\nTIMEOUT_SECONDS=%s\n' "$RUNNER" "$runtime_commit" "$TARGET" "$TIMEOUT_SECONDS"
  printf 'RUN_COMMAND=setsid --wait timeout --foreground --kill-after=1s %ss %q %q\n' "$TIMEOUT_SECONDS" "$RUNNER" "$TARGET"
} >"$META_FILE"

run_guarded() {
  local seconds="$1"
  shift
  local guard_pid guard_pgid guard_exit

  setsid --wait timeout --foreground --kill-after=1s "${seconds}s" "$@" &
  guard_pid=$!
  guard_pgid="$(ps -o pgid= -p "$guard_pid" | tr -d ' ')"
  GUARD_PID="$guard_pid"
  GUARD_PGID="$guard_pgid"

  wait "$guard_pid"
  guard_exit=$?

  GUARD_CLEANUP="NOT_NEEDED"
  GUARD_RESIDUAL="0"
  if [[ "$guard_exit" -ne 0 && -n "$guard_pgid" ]]; then
    GUARD_CLEANUP="TERM_THEN_KILL"
    kill -TERM -- "-$guard_pgid" 2>/dev/null || true
    sleep 0.05
    if kill -0 -- "-$guard_pgid" 2>/dev/null; then
      kill -KILL -- "-$guard_pgid" 2>/dev/null || true
      sleep 0.05
    fi
    if kill -0 -- "-$guard_pgid" 2>/dev/null; then
      GUARD_RESIDUAL="1"
    fi
  fi
  return "$guard_exit"
}

if [[ ! -f "$TARGET" ]]; then
  echo "CLI_ERROR=missing-target-or-runner" >&2
  printf 'PROCESS_EXIT=2\nCAUSE=missing-target-or-runner\n' >>"$META_FILE"
  echo "EVIDENCE_DIR=$EVIDENCE_DIR"
  exit 2
fi

set +e
run_guarded "$TIMEOUT_SECONDS" "$TOOLS_ROOT/scripts/fl-cgc-check" "$TARGET" >"$CHECK_STDOUT_FILE" 2>"$CHECK_STDERR_FILE"
check_exit=$?
set -e
printf 'CHECK_EXIT=%s\nCHECK_GUARD_PID=%s\nCHECK_GUARD_PGID=%s\nCHECK_CLEANUP=%s\nCHECK_RESIDUAL=%s\n' \
  "$check_exit" "$GUARD_PID" "$GUARD_PGID" "$GUARD_CLEANUP" "$GUARD_RESIDUAL" >>"$META_FILE"
if [[ "$check_exit" -ne 0 ]]; then
  if [[ "$check_exit" -eq 124 || "$check_exit" -eq 137 ]]; then
    printf 'CAUSE=TIMEOUT_CHECK\n' >>"$META_FILE"
  elif [[ "$check_exit" -ge 128 ]]; then
    printf 'CAUSE=SIGNAL_CHECK:%s\n' "$((check_exit - 128))" >>"$META_FILE"
  else
    printf 'CAUSE=CHECK_FAILURE\n' >>"$META_FILE"
  fi
  echo "CLI_ERROR=check-failed" >&2
  echo "EVIDENCE_DIR=$EVIDENCE_DIR"
  exit 2
fi

set +e
run_guarded "$TIMEOUT_SECONDS" "$RUNNER" "$TARGET" >"$STDOUT_FILE" 2>"$STDERR_FILE"
run_exit=$?
set -e
printf 'RUN_EXIT=%s\nRUN_GUARD_PID=%s\nRUN_GUARD_PGID=%s\nRUN_CLEANUP=%s\nRUN_RESIDUAL=%s\n' \
  "$run_exit" "$GUARD_PID" "$GUARD_PGID" "$GUARD_CLEANUP" "$GUARD_RESIDUAL" >>"$META_FILE"
if [[ "$run_exit" -eq 124 || "$run_exit" -eq 137 ]]; then
  printf 'CAUSE=TIMEOUT\n' >>"$META_FILE"
elif [[ "$run_exit" -ge 128 ]]; then
  printf 'CAUSE=SIGNAL:%s\n' "$((run_exit - 128))" >>"$META_FILE"
elif [[ "$run_exit" -ne 0 ]]; then
  printf 'CAUSE=PROCESS_FAILURE\n' >>"$META_FILE"
fi

set +e
cli_protocol_output="$($TOOLS_ROOT/scripts/fl-native-cli-protocol "$STDOUT_FILE" "$FINAL_FILE" 2>"$EVIDENCE_DIR/cli-protocol.stderr.log")"
cli_protocol_exit=$?
set -e
printf '%s\n' "$cli_protocol_output" >"$EVIDENCE_DIR/cli-protocol.stdout.log"
if [[ "$cli_protocol_exit" -ne 0 ]]; then
  echo "CLI_ERROR=incomplete-final-protocol" >&2
  echo "EVIDENCE_DIR=$EVIDENCE_DIR"
  exit 2
fi
exit_marker="$(sed -n 's/^CLI_EXIT_MARKER=//p' "$EVIDENCE_DIR/cli-protocol.stdout.log")"

set +e
protocol_output="$($TOOLS_ROOT/scripts/fl-protocol-check "$FINAL_FILE" "$exit_marker" "$run_exit" 2>"$EVIDENCE_DIR/protocol.stderr.log")"
protocol_exit=$?
set -e
printf '%s\n' "$protocol_output" >"$EVIDENCE_DIR/protocol.stdout.log"
if [[ "$protocol_exit" -ne 0 ]]; then
  echo "CLI_ERROR=invalid-final-result" >&2
  echo "EVIDENCE_DIR=$EVIDENCE_DIR"
  exit 2
fi

status="$(sed -n 's/^PROTO_STATUS=//p' "$EVIDENCE_DIR/protocol.stdout.log")"
verdict_exit="$(sed -n 's/^PROTO_EXIT_CODE=//p' "$EVIDENCE_DIR/protocol.stdout.log")"
if [[ "$run_exit" -ne 0 ]]; then
  echo "CLI_ERROR=runtime-exit:$run_exit" >&2
  echo "EVIDENCE_DIR=$EVIDENCE_DIR"
  exit 2
fi
printf 'FINAL_STATUS=%s\nFINAL_EXIT=%s\n' "$status" "$verdict_exit" >>"$META_FILE"
echo "EVIDENCE_DIR=$EVIDENCE_DIR"
exit "$verdict_exit"
