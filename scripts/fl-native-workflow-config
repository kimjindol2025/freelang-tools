#!/usr/bin/env bash
set -Eeuo pipefail
SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
TOOLS_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
CONFIG="${1:?config path required}"
[[ -f "$CONFIG" ]] || exit 0
FL_TOOLS_WORKFLOW_CONFIG="$CONFIG" "$TOOLS_ROOT/scripts/workflow-config-native"
