#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
TOOLS_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
INPUT=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --input) INPUT="${2:?--input requires a JSON file}"; shift ;;
    --help|-h) echo "사용법: fl-tools native-trust --input 파일"; exit 0 ;;
    *) echo "알 수 없는 옵션: $1" >&2; exit 2 ;;
  esac
  shift
done

if [[ -z "$INPUT" || ! -f "$INPUT" ]]; then
  echo "NATIVE_TRUST=BLOCKED" >&2
  echo "CAUSE=JSON input file is required" >&2
  exit 2
fi

RUNNER="${FREELANG_AFJ_RUNNER:-/home/kim/kim/platform/freelang-afj/bootstrap-native.js}"
PROBE="$TOOLS_ROOT/native/trust-core.fl"
if [[ ! -f "$RUNNER" ]]; then
  echo "NATIVE_TRUST=BLOCKED" >&2
  echo "CAUSE=AFJ runner not found: $RUNNER" >&2
  exit 2
fi

FL_TOOLS_TRUST_INPUT="$INPUT" node "$RUNNER" check "$PROBE" >/dev/null
OUTPUT="$(FL_TOOLS_TRUST_INPUT="$INPUT" node "$RUNNER" run "$PROBE")"
printf '%s\n' "$OUTPUT"
STATUS="$(sed -n 's/.*"verdict":"\([^"]*\)".*/\1/p' <<<"$OUTPUT")"
[[ "$STATUS" == TRUSTED || "$STATUS" == TRUSTED_WITH_APPROVAL || "$STATUS" == UNTRUSTED || "$STATUS" == BLOCKED ]]
