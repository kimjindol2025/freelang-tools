#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
TOOLS_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
ROOT="${1:?project root is required}"
DIALECT="${2:?dialect is required}"

if [[ "$DIALECT" != AIRC ]]; then
  echo "AIRC_CHECK=BLOCKED"
  echo "CAUSE=unexpected dialect: $DIALECT" >&2
  exit 2
fi
if [[ ! -d "$ROOT" || ! -x "$TOOLS_ROOT/scripts/cgc-native" ]]; then
  echo "AIRC_CHECK=BLOCKED"
  echo "CAUSE=project or cgc-native not found" >&2
  exit 2
fi

# AIRC source checks use the native cgc compiler.
mapfile -d '' SOURCES < <(find "$ROOT" -maxdepth 1 -type f -name '*.fl' -print0 | sort -z)

checked=0
failed=0
for source in "${SOURCES[@]}"; do
  [[ -n "$source" ]] || continue
  checked=$((checked + 1))
  echo "[fl-check] $source"
  if ! "$TOOLS_ROOT/scripts/fl-cgc-check" "$source"; then
    failed=1
  fi
done

echo "AIRC_CHECK_COUNT=$checked"
echo "AIRC_CHECK_EXIT=$failed"
if [[ "$failed" -ne 0 ]]; then
  echo "AIRC_CHECK=FAIL"
  exit 1
fi

echo "AIRC_CHECK=PASS"
