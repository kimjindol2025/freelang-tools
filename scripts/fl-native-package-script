#!/usr/bin/env bash
set -Eeuo pipefail
SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
TOOLS_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
ROOT="${1:?root required}"
ACTION="${2:?script name or list required}"
[[ -d "$ROOT" && -x "$TOOLS_ROOT/scripts/package-script-native" ]] || exit 2
set +e
FL_TOOLS_PACKAGE_ROOT="$ROOT" FL_TOOLS_PACKAGE_ACTION="$ACTION" \
  "$TOOLS_ROOT/scripts/package-script-native"
CODE=$?
set -e
exit "$CODE"
