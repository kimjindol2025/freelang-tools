#!/usr/bin/env bash
set -Eeuo pipefail
SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
TOOLS_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
ROOT="${1:?root required}"
ACTION="${2:?script name or list required}"
RUNNER="${FREELANG_AFJ_RUNNER:-/home/kim/kim/platform/freelang-afj/bootstrap-native.js}"
[[ -d "$ROOT" && -f "$RUNNER" ]] || exit 2
set +e
FL_TOOLS_PACKAGE_ROOT="$ROOT" FL_TOOLS_PACKAGE_ACTION="$ACTION" \
  node "$RUNNER" run "$TOOLS_ROOT/native/package-script.fl"
CODE=$?
set -e
exit "$CODE"
