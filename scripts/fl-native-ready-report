#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
TOOLS_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
RUNNER="${FREELANG_AFJ_RUNNER:-/home/kim/kim/platform/freelang-afj/bootstrap.js}"
[[ -f "$RUNNER" ]] || { echo "READY=BLOCKED" >&2; exit 2; }
exec node "$RUNNER" run "$TOOLS_ROOT/native/ready-report.fl"
