#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
TOOLS_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
TARGET="."
DEPLOY=NO
READ_ONLY=NO

while [[ $# -gt 0 ]]; do
  case "$1" in
    --deploy) DEPLOY=YES ;;
    --read-only|--verify-only) READ_ONLY=YES ;;
    --help|-h)
      cat <<'EOF'
사용법: fl-tools pipeline [경로] [--deploy] [--read-only]

기본 흐름:
  init → inspect → review → report → handoff

--deploy를 지정하면 review/report 통과 후 프로젝트 배포 계약도 실행한다.
Git push는 이 명령으로 실행하지 않는다.
--read-only를 지정하면 init/handoff 파일을 만들지 않고 검증 단계만 실행한다.
EOF
      exit 0
      ;;
    *) TARGET="$1" ;;
  esac
  shift
done

if [[ ! -d "$TARGET" ]]; then
  echo "PIPELINE=BLOCKED"
  echo "CAUSE=directory not found: $TARGET" >&2
  exit 2
fi

ROOT="$(cd -- "$TARGET" && pwd -P)"
run_step() {
  local name="$1"
  shift
  local output code
  echo "--- STEP_$name ---"
  set +e
  output="$("$@" 2>&1)"
  code=$?
  set -e
  printf '%s\n' "$output"
  printf -v "STEP_${name}_CODE" '%s' "$code"
  if [[ "$code" -eq 0 ]]; then
    echo "STEP_$name=PASS"
  else
    echo "STEP_$name=FAIL"
  fi
}

if [[ "$READ_ONLY" == YES ]]; then
  echo "STEP_INIT=SKIPPED"
else
  run_step INIT "$TOOLS_ROOT/scripts/fl-init" "$ROOT"
fi
run_step INSPECT "$TOOLS_ROOT/scripts/fl-inspect" "$ROOT"
run_step REVIEW "$TOOLS_ROOT/scripts/fl-review" "$ROOT"
run_step REPORT "$TOOLS_ROOT/scripts/fl-report" "$ROOT"

if [[ "$DEPLOY" == YES && "${STEP_INIT_CODE:-2}" -eq 0 && "${STEP_INSPECT_CODE:-2}" -eq 0 &&
      "${STEP_REVIEW_CODE:-2}" -eq 0 && "${STEP_REPORT_CODE:-2}" -eq 0 ]]; then
  run_step DEPLOY "$TOOLS_ROOT/scripts/fl-deploy" "$ROOT"
elif [[ "$DEPLOY" == YES ]]; then
  echo "STEP_DEPLOY=BLOCKED"
  echo "CAUSE=previous pipeline step failed"
  STEP_DEPLOY_CODE=2
else
  echo "STEP_DEPLOY=SKIPPED"
  STEP_DEPLOY_CODE=SKIPPED
fi

if [[ "$READ_ONLY" == YES ]]; then
  echo "STEP_HANDOFF=SKIPPED"
else
  run_step HANDOFF "$TOOLS_ROOT/scripts/fl-handoff" "$ROOT"
fi

set +e
"$TOOLS_ROOT/scripts/fl-native-pipeline" "${STEP_INIT_CODE:-2}" "${STEP_INSPECT_CODE:-2}" \
  "${STEP_REVIEW_CODE:-2}" "${STEP_REPORT_CODE:-2}" "${STEP_DEPLOY_CODE:-SKIPPED}" "${STEP_HANDOFF_CODE:-2}"
PIPELINE_CODE=$?
set -e
exit "$PIPELINE_CODE"
