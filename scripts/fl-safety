#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
TOOLS_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
STATE_FILE="${FREELANG_SAFETY_STATE:-/home/kim/kim/projects/skill-atlas/safety-state.json}"
ACTION="${1:-show}"
MODE="${2:-}"

if [[ "$ACTION" == "--help" || "$ACTION" == "-h" ]]; then
  echo "사용법: fl-tools safety [show|set strict|set advisory|set off]"
  exit 0
fi
if [[ "$ACTION" != "show" && "$ACTION" != "set" ]]; then
  echo "사용법: fl-tools safety [show|set strict|set advisory|set off]" >&2
  exit 2
fi
if [[ "$ACTION" == "set" && -z "$MODE" ]]; then
  echo "SAFETY=INVALID"
  echo "CAUSE=mode must be strict, advisory, or off"
  exit 2
fi

FL_TOOLS_SAFETY_STATE="$STATE_FILE" \
FL_TOOLS_SAFETY_ACTION="$ACTION" \
FL_TOOLS_SAFETY_MODE="$MODE" \
  "$TOOLS_ROOT/scripts/safety-core-native"
