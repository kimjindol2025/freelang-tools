#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
TOOLS_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
EVIDENCE_DIR="${1:-}"
PROCESS_EXIT="${2:-2}"

if [[ -z "$EVIDENCE_DIR" || ! -d "$EVIDENCE_DIR" ]]; then
  exit 2
fi

FL_TOOLS_EVIDENCE_DIR="$EVIDENCE_DIR" \
FL_TOOLS_EVIDENCE_PROCESS_EXIT="$PROCESS_EXIT" \
  "$TOOLS_ROOT/scripts/evidence-manifest-native"
