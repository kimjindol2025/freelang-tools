#!/usr/bin/env bash
set -Eeuo pipefail
SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
TOOLS_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
CAPABILITY="${1:?capability status required}"
REVIEW="${2:?review status required}"
FL_TOOLS_TRUST_CAPABILITY="$CAPABILITY" FL_TOOLS_TRUST_REVIEW="$REVIEW" \
  "$TOOLS_ROOT/scripts/trust-limitations-native"
