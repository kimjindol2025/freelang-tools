#!/usr/bin/env bash
set -Eeuo pipefail
SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
TOOLS_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
RUNNER="${FREELANG_AFJ_RUNNER:-/home/kim/kim/platform/freelang-afj/bootstrap-native.js}"
FL_TOOLS_START_PROJECT="${FL_TOOLS_START_PROJECT:-unknown}" \
FL_TOOLS_START_DIALECT="${FL_TOOLS_START_DIALECT:-UNKNOWN}" \
FL_TOOLS_START_RUNTIME="${FL_TOOLS_START_RUNTIME:-UNKNOWN}" \
FL_TOOLS_START_ENTRYPOINT="${FL_TOOLS_START_ENTRYPOINT:-none}" \
FL_TOOLS_START_RUNNER="${FL_TOOLS_START_RUNNER:-none}" \
FL_TOOLS_START_TARGET="${FL_TOOLS_START_TARGET:-.}" \
FL_TOOLS_START_BUILD="${FL_TOOLS_START_BUILD:-none}" \
FL_TOOLS_START_DOCS="${FL_TOOLS_START_DOCS:-0}" \
FL_TOOLS_START_GIT="${FL_TOOLS_START_GIT:-not-a-repository}" \
FL_TOOLS_START_BRANCH="${FL_TOOLS_START_BRANCH:-none}" \
FL_TOOLS_START_DOCTOR="${FL_TOOLS_START_DOCTOR:-FAIL}" \
  node "$RUNNER" run "$TOOLS_ROOT/native/start-report.fl"
