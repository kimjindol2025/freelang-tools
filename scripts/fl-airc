#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
TOOLS_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
TARGET="."

if [[ -n "${1:-}" && -d "$1" ]]; then
  TARGET="$1"
  shift
fi

ROOT="$(cd -- "$TARGET" && pwd -P)"
DETECT_OUTPUT="$($TOOLS_ROOT/scripts/fl-detect "$ROOT")"
DIALECT="$(printf '%s\n' "$DETECT_OUTPUT" | sed -n 's/^DIALECT=//p')"

if [[ "$DIALECT" != AIRC ]]; then
  echo "AIRC=BLOCKED"
  echo "CAUSE=project is not detected as AIRC: $ROOT" >&2
  exit 2
fi
if [[ ! -x "$TOOLS_ROOT/scripts/cgc-native" ]]; then
  echo "AIRC=BLOCKED"
  echo "CAUSE=cgc-native not found" >&2
  exit 2
fi
if [[ ! -f "$ROOT/airc.fl" ]]; then
  echo "AIRC=BLOCKED"
  echo "CAUSE=airc.fl not found: $ROOT" >&2
  exit 2
fi

COMMAND="${1:-status}"
shift || true
echo "AIRC_PROJECT=$ROOT"
echo "AIRC_RUNTIME=cgc-native"
echo "AIRC_COMMAND=$COMMAND"
exec "$TOOLS_ROOT/scripts/fl-cgc-run" "$ROOT/airc.fl" "$COMMAND" "$@"
