#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
TOOLS_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"

if [[ ! -x "$TOOLS_ROOT/scripts/evidence-report-native" ]]; then
  exit 2
fi

OUTPUT="$("$TOOLS_ROOT/scripts/evidence-report-native")"
status="$(sed -n 's/^EVIDENCE_STATUS=//p' <<<"$OUTPUT")"
if [[ -z "$status" ]]; then
  exit 2
fi
sed '/^EVIDENCE_STATUS=/d' <<<"$OUTPUT"
if [[ "$status" == PASS || "$status" == PASS_WITH_APPROVAL ]]; then
  exit 0
fi
exit 1
