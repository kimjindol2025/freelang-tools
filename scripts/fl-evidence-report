#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
TOOLS_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
RUNNER="${FREELANG_AFJ_RUNNER:-/home/kim/kim/platform/freelang-afj/bootstrap.js}"

if [[ ! -f "$RUNNER" ]]; then
  exit 2
fi

OUTPUT="$(node "$RUNNER" run "$TOOLS_ROOT/native/evidence-report.fl")"
status="$(sed -n 's/^EVIDENCE_STATUS=//p' <<<"$OUTPUT")"
if [[ -z "$status" ]]; then
  exit 2
fi
sed '/^EVIDENCE_STATUS=/d' <<<"$OUTPUT"
