#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
TOOLS_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
JSON_ONLY=NO
OUTPUT=""
TARGET="."

while [[ $# -gt 0 ]]; do
  case "$1" in
    --json) JSON_ONLY=YES ;;
    --output) OUTPUT="${2:?--output requires a file path}"; shift ;;
    --help|-h)
      echo "사용법: fl-tools evidence --json [--output 파일] [경로]"
      exit 0
      ;;
    *) TARGET="$1" ;;
  esac
  shift
done

if [[ "$JSON_ONLY" != YES ]]; then
  echo "EVIDENCE=BLOCKED"
  echo "CAUSE=--json is required" >&2
  exit 2
fi
if [[ ! -d "$TARGET" ]]; then
  echo "EVIDENCE=BLOCKED"
  echo "CAUSE=directory not found: $TARGET" >&2
  exit 2
fi

ROOT="$(cd -- "$TARGET" && pwd -P)"
DETECT_OUTPUT="$($TOOLS_ROOT/scripts/fl-detect "$ROOT")"
TMP_DIR="$(mktemp -d)"
cleanup() { rm -rf "$TMP_DIR"; }
trap cleanup EXIT INT TERM

STATUS_OUTPUT=""
STATUS_CODE=0
set +e
STATUS_OUTPUT="$($TOOLS_ROOT/scripts/fl-status "$ROOT" 2>&1)"
STATUS_CODE=$?
set -e

REVIEW_OUTPUT=""
REVIEW_CODE=0
set +e
REVIEW_OUTPUT="$($TOOLS_ROOT/scripts/fl-review "$ROOT" 2>&1)"
REVIEW_CODE=$?
set -e

GIT_STATUS_OUTPUT=""
if git -C "$ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  GIT_STATUS_OUTPUT="$(git -C "$ROOT" status --short)"
  BRANCH="$(git -C "$ROOT" branch --show-current)"
  COMMIT="$(git -C "$ROOT" rev-parse HEAD)"
  GIT_STATE=clean
  [[ -n "$GIT_STATUS_OUTPUT" ]] && GIT_STATE=dirty
else
  BRANCH=none
  COMMIT=none
  GIT_STATE=not-a-repository
fi

DIFF_CHECK=PASS
git -C "$ROOT" diff --check >/dev/null 2>&1 || DIFF_CHECK=FAIL

printf '%s' "$DETECT_OUTPUT" > "$TMP_DIR/detect.out"
printf '%s' "$STATUS_OUTPUT" > "$TMP_DIR/status.out"
printf '%s' "$REVIEW_OUTPUT" > "$TMP_DIR/review.out"

PROJECT="$(printf '%s\n' "$DETECT_OUTPUT" | sed -n 's/^PROJECT=//p')"
DIALECT="$(printf '%s\n' "$DETECT_OUTPUT" | sed -n 's/^DIALECT=//p')"
RUNNER="$(printf '%s\n' "$DETECT_OUTPUT" | sed -n 's/^RUNNER=//p')"
set +e
EVIDENCE_JSON="$(
  FL_TOOLS_EVIDENCE_PROJECT="$PROJECT" \
  FL_TOOLS_EVIDENCE_ROOT="$ROOT" \
  FL_TOOLS_EVIDENCE_DIALECT="$DIALECT" \
  FL_TOOLS_EVIDENCE_RUNNER="$RUNNER" \
  FL_TOOLS_EVIDENCE_BRANCH="$BRANCH" \
  FL_TOOLS_EVIDENCE_COMMIT="$COMMIT" \
  FL_TOOLS_EVIDENCE_GIT_STATE="$GIT_STATE" \
  FL_TOOLS_EVIDENCE_GIT_STATUS="$GIT_STATUS_OUTPUT" \
  FL_TOOLS_EVIDENCE_STATUS_CODE="$STATUS_CODE" \
  FL_TOOLS_EVIDENCE_REVIEW_CODE="$REVIEW_CODE" \
  FL_TOOLS_EVIDENCE_DIFF="$DIFF_CHECK" \
  FL_TOOLS_EVIDENCE_RAW_DETECT_FILE="$TMP_DIR/detect.out" \
  FL_TOOLS_EVIDENCE_RAW_STATUS_FILE="$TMP_DIR/status.out" \
  FL_TOOLS_EVIDENCE_RAW_REVIEW_FILE="$TMP_DIR/review.out" \
    "$TOOLS_ROOT/scripts/fl-evidence-report"
 )"
EVIDENCE_REPORT_CODE=$?
set -e

if [[ -n "$OUTPUT" ]]; then
  mkdir -p "$(dirname -- "$OUTPUT")"
  printf '%s' "$EVIDENCE_JSON" > "$OUTPUT"
  printf 'EVIDENCE_FILE=%s\n' "$OUTPUT" >&2
else
  printf '%s' "$EVIDENCE_JSON"
fi

if [[ "$EVIDENCE_REPORT_CODE" -ne 0 ]]; then
  echo "EVIDENCE=FAIL" >&2
  exit 1
fi

echo "EVIDENCE=PASS" >&2
