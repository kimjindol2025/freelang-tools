#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
TOOLS_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
TARGET="${1:-.}"

if [[ ! -d "$TARGET" ]]; then
  echo "GIT_NATIVE=BLOCKED" >&2
  echo "CAUSE=directory-or-AFJ-runner-not-found" >&2
  exit 2
fi

ROOT="$(cd -- "$TARGET" && pwd -P)"
OUTPUT="$(FL_TOOLS_GIT_ROOT="$ROOT" "$TOOLS_ROOT/scripts/git-core-native")"
printf '%s\n' "$OUTPUT"
grep -q '^GIT_NATIVE=PASS$' <<<"$OUTPUT"
