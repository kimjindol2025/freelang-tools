#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
TOOLS_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"

OUTPUT="$("$TOOLS_ROOT/scripts/trust-report-native")"
verdict="$(sed -n 's/^TRUST_VERDICT=//p' <<<"$OUTPUT")"
if [[ -z "$verdict" ]]; then
  exit 2
fi
sed '/^TRUST_VERDICT=/d' <<<"$OUTPUT"
if [[ "$verdict" == TRUSTED || "$verdict" == TRUSTED_WITH_APPROVAL ]]; then
  exit 0
fi
exit 1
