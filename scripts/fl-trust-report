#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
TOOLS_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
RUNNER="${FREELANG_AFJ_RUNNER:-/home/kim/kim/platform/freelang-afj/bootstrap-native.js}"

if [[ ! -f "$RUNNER" ]]; then
  exit 2
fi

OUTPUT="$(node "$RUNNER" run "$TOOLS_ROOT/native/trust-report.fl")"
verdict="$(sed -n 's/^TRUST_VERDICT=//p' <<<"$OUTPUT")"
if [[ -z "$verdict" ]]; then
  exit 2
fi
sed '/^TRUST_VERDICT=/d' <<<"$OUTPUT"
if [[ "$verdict" == TRUSTED || "$verdict" == TRUSTED_WITH_APPROVAL ]]; then
  exit 0
fi
exit 1
