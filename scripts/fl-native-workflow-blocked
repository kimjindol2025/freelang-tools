#!/usr/bin/env bash
set -Eeuo pipefail
SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
TOOLS_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
ROOT="${1:?root required}"; RUN="${2:?run mode required}"; REASON="${3:?reason required}"; OUT="${4:?output path required}"
FL_TOOLS_WORKFLOW_BLOCKED_ROOT="$ROOT" FL_TOOLS_WORKFLOW_BLOCKED_RUN="$RUN" FL_TOOLS_WORKFLOW_BLOCKED_REASON="$REASON" \
  "$TOOLS_ROOT/scripts/workflow-blocked-native" >"$OUT"
