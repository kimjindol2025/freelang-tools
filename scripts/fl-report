#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
TOOLS_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
TARGET="${1:-.}"

if [[ ! -d "$TARGET" ]]; then
  echo "REPORT=BLOCKED"
  echo "CAUSE=directory not found: $TARGET" >&2
  exit 2
fi

ROOT="$(cd -- "$TARGET" && pwd -P)"
DETECT_OUTPUT="$($TOOLS_ROOT/scripts/fl-detect "$ROOT")"
PROJECT="$(printf '%s\n' "$DETECT_OUTPUT" | sed -n 's/^PROJECT=//p')"
DIALECT="$(printf '%s\n' "$DETECT_OUTPUT" | sed -n 's/^DIALECT=//p')"
RUNNER="$(printf '%s\n' "$DETECT_OUTPUT" | sed -n 's/^RUNNER=//p')"

STATUS_OUTPUT=""
STATUS_CODE=0
set +e
STATUS_OUTPUT="$($TOOLS_ROOT/scripts/fl-status "$ROOT" 2>&1)"
STATUS_CODE=$?
set -e

REVIEW_OUTPUT=""
REVIEW_CODE=0
set +e
REVIEW_OUTPUT="$($TOOLS_ROOT/scripts/fl-review "$ROOT" 2>&1)"
REVIEW_CODE=$?
set -e

GIT_STATUS="not-a-repository"
BRANCH="none"
if git -C "$ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  BRANCH="$(git -C "$ROOT" branch --show-current)"
  if [[ -n "$(git -C "$ROOT" status --short)" ]]; then
    GIT_STATUS=dirty
  else
    GIT_STATUS=clean
  fi
fi

REPORT_OUTPUT="$($TOOLS_ROOT/scripts/fl-native-report "$PROJECT" "$ROOT" "$DIALECT" "$RUNNER" "$BRANCH" "$GIT_STATUS" "$STATUS_OUTPUT" "$REVIEW_OUTPUT" "$STATUS_CODE" "$REVIEW_CODE")"
REPORT_STATUS="$(sed -n 's/^REPORT_STATUS=//p' <<<"$REPORT_OUTPUT")"
sed '/^REPORT_STATUS=/d' <<<"$REPORT_OUTPUT"
if [[ "$REPORT_STATUS" == PASS ]]; then
  echo "REPORT=PASS"
else
  echo "REPORT=FAIL"
  exit 1
fi
