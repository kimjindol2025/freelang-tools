#!/usr/bin/env bash
set -Eeuo pipefail
SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
TOOLS_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
KIND="${1:?kind required}"; LABEL="${2:?label required}"; COMMAND="${3:?command required}"; CODE="${4:?exit code required}"; OUTPUT="${5:?output path required}"
FL_TOOLS_WORKFLOW_KIND="$KIND" FL_TOOLS_WORKFLOW_LABEL="$LABEL" \
FL_TOOLS_WORKFLOW_COMMAND="$COMMAND" FL_TOOLS_WORKFLOW_CODE="$CODE" \
FL_TOOLS_WORKFLOW_OUTPUT="$OUTPUT" \
  "$TOOLS_ROOT/scripts/workflow-entry-native"
