#!/usr/bin/env bash
set -Eeuo pipefail
SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
TOOLS_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
ROOT_PATH="${1:?root required}"
TEST_ROOT_PATH="${2:?test root required}"
FL_TOOLS_TEST_PLAN_ROOT="$ROOT_PATH" \
FL_TOOLS_TEST_PLAN_TEST_ROOT="$TEST_ROOT_PATH" \
  "$TOOLS_ROOT/scripts/test-plan-native"
