#!/usr/bin/env bash
set -Eeuo pipefail
SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
TOOLS_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
URL="${1:-}"
if [[ -z "$URL" ]]; then
  echo "HTTP_NATIVE=BLOCKED" >&2
  exit 2
fi
FL_TOOLS_HTTP_URL="$URL" "$TOOLS_ROOT/scripts/http-core-native"
