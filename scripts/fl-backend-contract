#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
TOOLS_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
INPUT="${1:-}"
RUNNER="${FREELANG_AFJ_RUNNER:-/home/kim/kim/platform/freelang-afj/bootstrap-native.js}"

if [[ -z "$INPUT" || ! -f "$INPUT" || ! -f "$RUNNER" ]]; then
  echo "BACKEND_CONTRACT=BLOCKED" >&2
  echo "CAUSE=input-and-AFJ-runner-are-required" >&2
  exit 2
fi

OUTPUT="$(FL_TOOLS_BACKEND_INPUT="$INPUT" node "$RUNNER" run "$TOOLS_ROOT/native/backend-contract.fl")"
printf '%s\n' "$OUTPUT"
grep -q '^BACKEND_CONTRACT=PASS$' <<<"$OUTPUT"
