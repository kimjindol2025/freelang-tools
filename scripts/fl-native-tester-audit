#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
TOOLS_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
INPUT=""
OUTPUT_FILE=""
RUN_MODE=NO
while [[ $# -gt 0 ]]; do
  case "$1" in
    --input) INPUT="${2:?--input requires a JSON file}"; shift ;;
    --output) OUTPUT_FILE="${2:?--output requires a JSON file}"; shift ;;
    --run) RUN_MODE=YES ;;
    --help|-h) echo "사용법: fl-tools tester-audit --run [--output 파일] | --input 파일"; exit 0 ;;
    *) echo "알 수 없는 옵션: $1" >&2; exit 2 ;;
  esac
  shift
done
RUNNER="${FREELANG_TESTER_RUNNER:-$TOOLS_ROOT/scripts/tester-runner-native}"
REGISTRY="${FREELANG_TESTER_REGISTRY:-$TOOLS_ROOT/scripts/tester-registry-native}"
PROBE="${FL_TOOLS_TESTER_PROBE:-$TOOLS_ROOT/native/tester-registry.fl}"
if [[ ! -f "$PROBE" ]]; then
  echo "TESTER_AUDIT=BLOCKED" >&2
  echo "CAUSE=probe not found" >&2
  exit 2
fi
STALE_DIR="$(mktemp -d "${TMPDIR:-/tmp}/tester-reg-stale.XXXXXX")"
"$TOOLS_ROOT/scripts/cgc-native" "$PROBE" "$STALE_DIR/tr.c" >/dev/null 2>&1 || true
if [[ -f "$STALE_DIR/tr.c" ]]; then
  gcc -Wno-unused -I "${FREELANG_V11_RUNTIME:-$HOME/work/fl-8/freelang-v11/runtime}" \
    -o "$STALE_DIR/tester-registry-native" "$STALE_DIR/tr.c" \
    "${FREELANG_V11_RUNTIME:-$HOME/work/fl-8/freelang-v11/runtime}/core.c" \
    "${FREELANG_V11_RUNTIME:-$HOME/work/fl-8/freelang-v11/runtime}/collection.c" \
    "${FREELANG_V11_RUNTIME:-$HOME/work/fl-8/freelang-v11/runtime}/io.c" \
    "${FREELANG_V11_RUNTIME:-$HOME/work/fl-8/freelang-v11/runtime}/math.c" \
    "${FREELANG_V11_RUNTIME:-$HOME/work/fl-8/freelang-v11/runtime}/error.c" \
    "${FREELANG_V11_RUNTIME:-$HOME/work/fl-8/freelang-v11/runtime}/process.c" \
    "${FREELANG_V11_RUNTIME:-$HOME/work/fl-8/freelang-v11/runtime}/json.c" \
    "${FREELANG_V11_RUNTIME:-$HOME/work/fl-8/freelang-v11/runtime}/cgc-bridge.c" -lm >/dev/null 2>&1 || true
fi
if [[ ! -f "$STALE_DIR/tester-registry-native" ]] || ! cmp -s "$REGISTRY" "$STALE_DIR/tester-registry-native"; then
  rm -rf "$STALE_DIR"
  echo "TESTER_AUDIT=BLOCKED" >&2
  echo "CAUSE=tester-registry-native-stale" >&2
  exit 2
fi
rm -rf "$STALE_DIR"
if [[ "$RUN_MODE" == YES ]]; then
  if [[ -n "$INPUT" ]]; then
    echo "TESTER_AUDIT=BLOCKED" >&2
    echo "CAUSE=--run cannot be combined with --input" >&2
    exit 2
  fi
  if [[ ! -f "$RUNNER" ]]; then
    echo "TESTER_AUDIT=BLOCKED" >&2
    echo "CAUSE=native runner not found" >&2
    exit 2
  fi
  if [[ -n "$OUTPUT_FILE" ]]; then
    INPUT="$OUTPUT_FILE"
  else
    INPUT_DIR="$(mktemp -d)"
    INPUT="$INPUT_DIR/results.json"
    cleanup() { rm -rf "$INPUT_DIR"; }
    trap cleanup EXIT INT TERM
  fi
  FL_TOOLS_ROOT="$TOOLS_ROOT" \
  FL_TOOLS_TESTER_AUDIT_RUN_OUTPUT="$INPUT" \
    "$RUNNER" >/dev/null
fi

if [[ -z "$INPUT" || ! -f "$INPUT" || ! -f "$REGISTRY" ]]; then
  echo "TESTER_AUDIT=BLOCKED" >&2
  echo "CAUSE=input or native runner not found" >&2
  exit 2
fi

set +e
"$TOOLS_ROOT/scripts/fl-probe-check" "$PROBE" >/dev/null
PCHK=$?
set -e
if [[ "$PCHK" -ne 0 ]]; then
  echo "TESTER_AUDIT=BLOCKED" >&2
  echo "CAUSE=probe check failed" >&2
  exit 2
fi
OUTPUT="$(FL_TOOLS_TESTER_AUDIT_INPUT="$INPUT" "$REGISTRY")"
printf '%s\n' "$OUTPUT"
VERDICT="$(sed -n 's/.*"verdict":"\([^"]*\)".*/\1/p' <<<"$OUTPUT")"
case "$VERDICT" in
  PASS) exit 0 ;;
  UNRESOLVED|FAIL|BLOCKED) exit 1 ;;
  *) echo "TESTER_AUDIT=BLOCKED" >&2; exit 2 ;;
esac
