#!/usr/bin/env bash
set -Eeuo pipefail

# Direct capability probe. This records runtime evidence only; the FreeLang
# effect module remains the owner of the BLOCKED product decision.
SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
TOOLS_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
RUNTIME="${FREELANG_AFJ_RUNNER:-/root/freelang-surface-v0-clean-ek3qo2/v11/bootstrap.js}"
PROBE="$TOOLS_ROOT/tests/capability/effect-tape-probe.fl"
STAMP="${TMPDIR:-/tmp}/freelang-effect-capability.$$"
CHECK_OUT="${STAMP}.check.log"
RUN_OUT="${STAMP}.run.log"

cleanup() { rm -f -- "$CHECK_OUT" "$RUN_OUT"; }
trap cleanup EXIT INT TERM

if [[ ! -f "$RUNTIME" || ! -f "$PROBE" ]]; then
  echo "EFFECT_TAPE_PROBE=BLOCKED"
  echo "CAUSE=runtime-or-probe-missing" >&2
  exit 2
fi

set +e
node "$RUNTIME" check "$PROBE" >"$CHECK_OUT" 2>&1
CHECK_CODE=$?
node "$RUNTIME" run "$PROBE" >"$RUN_OUT" 2>&1
RUN_CODE=$?
set -e

echo "RUNTIME=$RUNTIME"
echo "PROBE=$PROBE"
echo "CHECK_EXIT=$CHECK_CODE"
echo "RUN_EXIT=$RUN_CODE"
echo "--- CHECK ---"
cat "$CHECK_OUT"
echo "--- RUN ---"
cat "$RUN_OUT"

if [[ "$CHECK_CODE" -ne 0 ]]; then
  echo "EFFECT_TAPE_PROBE=ERROR"
  exit 2
fi
if [[ "$RUN_CODE" -eq 0 ]]; then
  echo "EFFECT_TAPE_PROBE=UNEXPECTED_SUCCESS"
  exit 2
fi
if grep -q '^EFFECT_TAPE_PROBE_BODY_EXECUTED$' "$RUN_OUT"; then
  echo "EFFECT_TAPE_PROBE=ERROR"
  echo "CAUSE=probe-body-ran-before-capability-confirmation" >&2
  exit 2
fi

echo "EFFECT_TAPE_PROBE=BLOCKED"
echo "CAUSE=runtime-did-not-expose-a-public-effect-tape-api"
exit 0
