#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
TOOLS_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
TARGET="${1:-.}"

if [[ ! -d "$TARGET" ]]; then
  printf '{"schemaVersion":"freelang.ready/v1","status":"BLOCKED","project":{"name":"unknown","root":"%s","dialect":"UNKNOWN","family":"UNKNOWN","runner":"none"},"git":{"state":"not-a-repository","branch":"none","commit":"none"},"dependencies":{"runnerReady":false},"next":"resolve-readiness-reason-and-rerun","reason":"directory-not-found"}\n' "$TARGET"
  exit 2
fi

ROOT="$(cd -- "$TARGET" && pwd -P)"
DETECT_OUTPUT="$($TOOLS_ROOT/scripts/fl-detect "$ROOT" 2>/dev/null || true)"
PROJECT="$(printf '%s\n' "$DETECT_OUTPUT" | sed -n 's/^PROJECT=//p')"
DIALECT="$(printf '%s\n' "$DETECT_OUTPUT" | sed -n 's/^DIALECT=//p')"
FAMILY="$(printf '%s\n' "$DETECT_OUTPUT" | sed -n 's/^FAMILY=//p')"
RUNNER="$(printf '%s\n' "$DETECT_OUTPUT" | sed -n 's/^RUNNER=//p')"

GIT_STATE=not-a-repository
GIT_BRANCH=none
GIT_COMMIT=none
if git -C "$ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  GIT_BRANCH="$(git -C "$ROOT" branch --show-current 2>/dev/null || printf 'none')"
  GIT_COMMIT="$(git -C "$ROOT" rev-parse HEAD 2>/dev/null || printf 'none')"
  if [[ -n "$(git -C "$ROOT" status --short 2>/dev/null)" ]]; then
    GIT_STATE=dirty
  else
    GIT_STATE=clean
  fi
fi

FL_TOOLS_READY_PROJECT="$PROJECT" \
FL_TOOLS_READY_ROOT="$ROOT" \
FL_TOOLS_READY_DIALECT="$DIALECT" \
FL_TOOLS_READY_FAMILY="$FAMILY" \
FL_TOOLS_READY_RUNNER="$RUNNER" \
FL_TOOLS_READY_GIT_STATE="$GIT_STATE" \
FL_TOOLS_READY_GIT_BRANCH="$GIT_BRANCH" \
FL_TOOLS_READY_GIT_COMMIT="$GIT_COMMIT" \
  "$TOOLS_ROOT/scripts/fl-native-ready-core"
