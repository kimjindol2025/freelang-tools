#!/usr/bin/env bash
set -Eeuo pipefail
SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
TOOLS_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
RUNNER="${FREELANG_AFJ_RUNNER:-/home/kim/kim/platform/freelang-afj/bootstrap-native.js}"
TMP_DIR="$(mktemp -d)"
cleanup() { rm -rf "$TMP_DIR"; }
trap cleanup EXIT INT TERM

set +e
node "$RUNNER" check "$TOOLS_ROOT/native/selfhost-probe.fl" >"$TMP_DIR/check.out" 2>&1
CHECK_CODE=$?
node "$RUNNER" run "$TOOLS_ROOT/native/selfhost-probe.fl" >"$TMP_DIR/run.out" 2>&1
RUN_CODE=$?
set -e

FL_TOOLS_SELFHOST_CHECK_OUTPUT="$TMP_DIR/check.out" \
FL_TOOLS_SELFHOST_RUN_OUTPUT="$TMP_DIR/run.out" \
FL_TOOLS_SELFHOST_CHECK_CODE="$CHECK_CODE" \
FL_TOOLS_SELFHOST_RUN_CODE="$RUN_CODE" \
  node "$RUNNER" run "$TOOLS_ROOT/native/selfhost-core.fl"
