#!/usr/bin/env bash
set -Eeuo pipefail
SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
TOOLS_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
RUNNER="${FREELANG_AFJ_RUNNER:-/home/kim/kim/platform/freelang-afj/bootstrap-native.js}"
FL_TOOLS_SELFHOST_RUNNER="$RUNNER" FL_TOOLS_SELFHOST_PROBE="$TOOLS_ROOT/native/selfhost-probe.fl" \
  node "$RUNNER" run "$TOOLS_ROOT/native/selfhost-core.fl"
