#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
TOOLS_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
TARGET_INPUT="${1:-.}"
shift || true
ROOT="$(cd -- "$TARGET_INPUT" && pwd -P)"

DETECT_OUTPUT="$($TOOLS_ROOT/scripts/fl-detect "$ROOT")"
DIALECT="$(printf '%s\n' "$DETECT_OUTPUT" | sed -n 's/^DIALECT=//p')"
DETECTED_RUNNER="$(printf '%s\n' "$DETECT_OUTPUT" | sed -n 's/^RUNNER=//p')"

if [[ "$DIALECT" == "AIRC" ]]; then
  if [[ "$DETECTED_RUNNER" == "none" || ! -f "$DETECTED_RUNNER" ]]; then
    echo "FREELANG_CHECK=BLOCKED"
    echo "CAUSE=AIRC runner not found: $DETECTED_RUNNER" >&2
    exit 2
  fi
  "$TOOLS_ROOT/scripts/fl-airc-check-batch" "$ROOT" "$DIALECT" "$DETECTED_RUNNER"
  echo "FREELANG_CHECK=PASS"
  exit 0
fi

if [[ "$DIALECT" == "NODE" ]]; then
  if [[ "${FREELANG_CHECK_QUICK:-NO}" == YES ]]; then
    echo "FREELANG_CHECK=PASS"
    echo "CHECK_SCOPE=package-and-runner"
    exit 0
  fi
  "$TOOLS_ROOT/scripts/fl-workflow-test" "$ROOT"
  echo "FREELANG_CHECK=PASS"
  exit 0
fi

if [[ "$DIALECT" != "AFJ" ]]; then
  echo "FREELANG_CHECK=DEFERRED"
  echo "DIALECT=$DIALECT"
  "$TOOLS_ROOT/scripts/fl-test" "$ROOT" "$@"
  exit 0
fi

"$TOOLS_ROOT/scripts/fl-native-check-batch" "$ROOT" "$DIALECT"

"$TOOLS_ROOT/scripts/fl-test" "$ROOT" "$@"
echo "FREELANG_CHECK=PASS"
