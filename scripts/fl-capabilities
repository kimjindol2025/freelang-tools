#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
TOOLS_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
TARGET="${1:-.}"

if [[ ! -d "$TARGET" ]]; then
  echo "CAPABILITIES=BLOCKED"
  echo "CAUSE=directory not found: $TARGET" >&2
  exit 2
fi

ROOT="$(cd -- "$TARGET" && pwd -P)"
DETECT_OUTPUT="$($TOOLS_ROOT/scripts/fl-detect "$ROOT")"
DIALECT="$(printf '%s\n' "$DETECT_OUTPUT" | sed -n 's/^DIALECT=//p')"
RUNNER="$(printf '%s\n' "$DETECT_OUTPUT" | sed -n 's/^RUNNER=//p')"
PROBE="$TOOLS_ROOT/native/capability-probe.fl"

if [[ "$DIALECT" != AFJ || ! -f "$RUNNER" ]]; then
  echo "CAPABILITIES=BLOCKED"
  echo "CAUSE=capability probe currently supports AFJ only"
  echo "DIALECT=$DIALECT"
  exit 2
fi

(cd "$ROOT" && node "$RUNNER" check "$PROBE" >/dev/null)
(cd "$ROOT" && node "$RUNNER" run "$PROBE")
