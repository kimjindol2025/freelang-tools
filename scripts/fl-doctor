#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
TARGET="${1:-.}"

TOOLS_ROOT="$ROOT"
DETECT_OUTPUT="$("$TOOLS_ROOT/scripts/fl-detect" "$TARGET")"
PROJECT_ROOT="$(printf '%s\n' "$DETECT_OUTPUT" | sed -n 's/^ROOT=//p')"
DIALECT="$(printf '%s\n' "$DETECT_OUTPUT" | sed -n 's/^DIALECT=//p')"
RUNNER="$(printf '%s\n' "$DETECT_OUTPUT" | sed -n 's/^RUNNER=//p')"
TEST_ROOT="$(printf '%s\n' "$DETECT_OUTPUT" | sed -n 's/^TEST_ROOT=//p')"

RUNNER_STATUS=BLOCKED
if [[ "$RUNNER" != "none" && -e "$RUNNER" ]]; then
  RUNNER_STATUS=PASS
fi

GIT_STATUS=NOT_A_REPOSITORY
if git -C "$PROJECT_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  GIT_STATUS=PASS
fi

TEST_STATUS=NOT_FOUND
if [[ -d "$TEST_ROOT" ]]; then
  TEST_STATUS=PASS
fi

MANIFEST_STATUS=UNKNOWN
if [[ -f "$PROJECT_ROOT/package.json" || -f "$PROJECT_ROOT/freelang.json" || "$DIALECT" == AIA ]]; then
  MANIFEST_STATUS=PASS
fi

TOOLS_STATUS=BLOCKED
if command -v fl-tools >/dev/null 2>&1 || [[ -x "$ROOT/scripts/fl-tools" ]]; then
  TOOLS_STATUS=PASS
fi

set +e
"$TOOLS_ROOT/scripts/fl-native-doctor" "$RUNNER_STATUS" "$GIT_STATUS" "$TEST_STATUS" "$MANIFEST_STATUS" "$TOOLS_STATUS"
CODE=$?
set -e
exit "$CODE"
