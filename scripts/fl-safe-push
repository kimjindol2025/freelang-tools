#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
TOOLS_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
PUSH=NO
REMOTE=""
BRANCH="$(git branch --show-current)"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --push) PUSH=YES ;;
    --remote) REMOTE="${2:?--remote requires a name}"; shift ;;
    --branch) BRANCH="${2:?--branch requires a name}"; shift ;;
    --help|-h)
      cat <<'EOF'
사용법: fl-tools safe-push [--remote <name>] [--branch <branch>] [--push]
기본 동작은 원격 상태 확인이며, 실제 push에는 --push가 필요하다.
EOF
      exit 0
      ;;
    *) echo "알 수 없는 옵션: $1" >&2; exit 2 ;;
  esac
  shift
done

if [[ -z "$REMOTE" ]]; then
  REMOTES=( $(git remote) )
else
  REMOTES=("$REMOTE")
fi
if [[ "${#REMOTES[@]}" -eq 0 ]]; then
  echo "SAFE_PUSH=BLOCKED"
  echo "CAUSE=no remotes"
  exit 1
fi

LOCAL_HEAD="$(git rev-parse HEAD)"
WORKTREE_STATUS=PASS
[[ -z "$(git status --short)" ]] || WORKTREE_STATUS=FAIL
REMOTE_STATUS=PASS
REMOTE_REPORT=""

for remote in "${REMOTES[@]}"; do
  if ! git config --get "remote.$remote.url" >/dev/null; then
    REMOTE_STATUS=FAIL
    REMOTE_REPORT+="REMOTE_${remote}=MISSING\n"
    continue
  fi
  REMOTE_HEAD="$(git ls-remote "$remote" "refs/heads/$BRANCH" | awk '{print $1}')"
  REMOTE_REPORT+="REMOTE_${remote}_HEAD=${REMOTE_HEAD:-NONE}\n"
done

set +e
PREFLIGHT_OUTPUT="$($TOOLS_ROOT/scripts/fl-native-safe-push "$REMOTE_STATUS" "$WORKTREE_STATUS" "$LOCAL_HEAD" "$BRANCH" "$PUSH" "$REMOTE_REPORT")"
PREFLIGHT_CODE=$?
set -e
printf '%s\n' "$PREFLIGHT_OUTPUT"
[[ "$PREFLIGHT_CODE" -eq 0 ]] || exit 1
if [[ "$PUSH" != YES ]]; then exit 0; fi

for remote in "${REMOTES[@]}"; do
  git push "$remote" "$BRANCH"
done
echo "SAFE_PUSH=PASS"
